---
import Layout from '../layouts/Layout.astro';
import HiggsfieldHeroStage from '../components/HiggsfieldHeroStage.jsx';
import ParallaxMotionReel from '../components/ParallaxMotionReel.jsx';
import MotionVaultGallery from '../components/MotionVaultGallery.jsx';
import CityServiceCard from '../components/CityServiceCard.astro';
import AEOFAQ from '../components/AEOFAQ.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';

const cityList = [
  {
    name: 'Virginia Beach',
    slug: '/virginia-beach-electrician',
    zipSample: '23451–23464',
    description: '200A/400A panel upgrades, Level 2 EV charger circuits, coastal NEMA 3R disconnects, chandelier rigging & standby generators across Oceanfront, Great Neck, Kempsville & Sandbridge.'
  },
  {
    name: 'Norfolk',
    slug: '/norfolk-electrician',
    zipSample: '23502–23518',
    description: 'Ghent & Freemason historic home rewiring, 3-phase commercial switchgear, multi-family meter banks, and 24/7 emergency troubleshooting across Norfolk & Ocean View.'
  },
  {
    name: 'Chesapeake',
    slug: '/chesapeake-electrician',
    zipSample: '23320–23325',
    description: 'NEC Article 680 swimming pool & hot tub subpanels, 200A breaker replacements, vaulted downrod ceiling fans, and EV charging across Greenbrier, Great Bridge & Hickory.'
  },
  {
    name: 'Newport News',
    slug: '/newport-news-electrician',
    zipSample: '23601–23608',
    description: 'Peninsula 200A service upgrades, utility meter sockets, whole-home surge protection, and commercial LED/power distribution across Oyster Point, Hilton Village & Denbigh.'
  },
  {
    name: 'Hampton',
    slug: '/hampton-electrician',
    zipSample: '23661–23669',
    description: 'Aluminum conductor remediation, coastal exterior weatherproofing, standby backup generator transfer switches, and 24/7 repairs across Phoebus, Buckroe Beach & Fox Hill.'
  },
  {
    name: 'Portsmouth',
    slug: '/portsmouth-electrician',
    zipSample: '23701–23707',
    description: 'Olde Towne & Churchland fuse-box-to-200A breaker conversions, municipal code violation corrections, AFCI/GFCI upgrades, and rapid emergency power restoration.'
  },
  {
    name: 'Suffolk',
    slug: '/suffolk-electrician',
    zipSample: '23434–23438',
    description: 'Detached workshop & barn subpanels, underground PVC feeder trenching, whole-estate 22kW–26kW standby generators, and EV circuits across Harbour View & North Suffolk.'
  }
];
---

<Layout
  title="24/7 Emergency Electrician, 200A Panel Upgrades & EV Chargers in Virginia Beach, Norfolk & 757 | Scott's Electric"
  description="Licensed Master Electrician serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth & Suffolk. 24/7 emergency repair, 200A/400A panel upgrades, EV chargers, 3-phase commercial & standby generators. Call (757) 536-0478."
>
  <!-- 1. Higgsfield Motion-Edit Hero Stage (Keyword-First H1 + 3D Speed-Ramp Viewfinder + Direct Phone CTA) -->
  <HiggsfieldHeroStage client:load />

  <!-- 2. High-Intent Technical Brief & AEO Direct Answer -->
  <section class="py-6 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AEODirectAnswer
        question="Need a licensed 24/7 emergency electrician or 200A panel upgrade in Hampton Roads (757)?"
        summary="Scott's Electric LLC dispatches licensed & insured Virginia Master Electricians (VA Class A Contractor) across all 7 cities of 757 for 24/7 emergency diagnostics, same-day 200A/400A main breaker panel upgrades, dedicated 240V Level 2 EV chargers, 3-phase commercial switchgear, and automatic standby generators—including Dominion Energy disconnect coordination and municipal permits."
        facts={[
          { label: "24/7 Emergency Dispatch", value: "Call (757) 536-0478 (<45 Min Avg)", highlight: true },
          { label: "200A Panel Upgrades", value: "$1,800 – $3,800 Same-Day Turnkey" },
          { label: "Level 2 EV Chargers", value: "$650 – $1,500 (Tesla / NACS / J1772)", highlight: true },
          { label: "Contractor Classification", value: "VA Master Electrician • Class A" },
          { label: "Utility & Code Alignment", value: "Dominion Energy + All 7 City Permits" },
          { label: "Commercial Capability", value: "120/208V & 277/480V 3-Phase" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- 3. Parallax Motion-Edit Scrollytelling Chapters + Interactive Before/After Panel Scrubbers -->
  <ParallaxMotionReel client:visible />

  <!-- 4. Complete 61-Photo Vision-Cataloged Jobsite Vault + Lightbox Inspector -->
  <MotionVaultGallery client:visible />

  <!-- 5. 7-City Hampton Roads Local SEO Coverage Grid -->
  <section class="py-20 bg-brand-dark border-t border-slate-800/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
        <div class="max-w-3xl">
          <span class="font-mono text-[11px] font-bold text-cyan-400 bg-cyan-500/10 px-3 py-1.5 rounded-full border border-cyan-500/25 uppercase tracking-widest">
            757 Regional Dispatch • Southside &amp; Peninsula
          </span>
          <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Licensed Master Electrician Serving <span class="gold-gradient-text">All 7 Cities of 757</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-300 mt-2.5">
            Select your municipality for local permitting information, neighborhood coverage, and 24/7 dispatch times.
          </p>
        </div>

        <a
          href="tel:7575360478"
          class="shrink-0 inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm px-5 py-3.5 rounded-xl shadow-gold-glow"
        >
          <span>24/7 Hotline: (757) 536-0478</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cityList.map(city => (
          <CityServiceCard
            cityName={city.name}
            slug={city.slug}
            description={city.description}
            zipSample={city.zipSample}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Interactive NEC Article 220 Load & Project Price Workbench -->
  <section id="instant-calculator" class="py-20 bg-brand-surface border-t border-slate-800/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <!-- 7. Answer-Engine Optimized FAQ & JSON-LD -->
  <AEOFAQ />
</Layout>
