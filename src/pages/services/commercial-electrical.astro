---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Commercial Electrical", url: `${siteConfig.url}/services/commercial-electrical` }
];

const serviceData = {
  name: "Commercial Electrical Contracting & 3-Phase Power",
  description: "3-phase power distribution (120/208V & 277/480V), retail and office tenant buildouts, high-bay commercial LED lighting, and 24/7 emergency dispatch in Hampton Roads (757).",
  url: `${siteConfig.url}/services/commercial-electrical`,
  priceRange: "$750 - $12,000+"
};

const commercialGalleryPhotos = [
  {
    src: '/assets/images/real/business_office_workspace_service/img_0806.webp',
    alt: "Commercial Office Workspace Power and Lighting",
    title: "Business & Office Electrical",
    category: "Commercial",
    desc: "Commercial workspace wiring and branch circuits."
  },
  {
    src: '/assets/images/real/panels/img_5010.webp',
    alt: "Electrical Subpanel Installation",
    title: "Electrical Panels",
    category: "Panels",
    desc: "Circuit breaker subpanel and power distribution."
  },
  {
    src: '/assets/images/real/ceiling_lights/img_3486.webp',
    alt: "Recessed Ceiling Lighting Grid",
    title: "Ceiling Lights",
    category: "Lighting",
    desc: "Recessed ceiling lights and fixture layout."
  },
  {
    src: '/assets/images/real/meters/img_5108.webp',
    alt: "Electric Meter Base and Service Entrance",
    title: "Meters & Service Entrances",
    category: "Service Entrance",
    desc: "Electric meter base and utility service connection."
  },
  {
    src: '/assets/images/real/switches/img_2677.webp',
    alt: "Switches and Wall Controls",
    title: "Switches & Controls",
    category: "Switches",
    desc: "Wall switches, dimmers, and control device wiring."
  },
  {
    src: '/assets/images/real/work_van_and_tools/img_4519.webp',
    alt: "Service Van and Tools",
    title: "Service Vans & Tools",
    category: "Equipment",
    desc: "Equipped service vehicle with electrical tooling and testing gear."
  }
];

const faqs = [
  {
    question: "What commercial electrical services does Scott's Electric provide in 757?",
    answer: "We provide 3-phase power distribution, commercial LED retrofits, retail tenant buildouts, dedicated machinery wiring, emergency lighting compliance, and industrial motor controls throughout Virginia Beach, Norfolk, Chesapeake, and Newport News."
  },
  {
    question: "Do you offer 24/7 emergency dispatch for commercial facilities in Hampton Roads?",
    answer: "Yes, we maintain priority on-call dispatch for commercial power outages, main distribution breaker trips, sparking panels, and code compliance violations."
  }
];
---

<Layout 
  title="Commercial Electrical Contractor 757 | 3-Phase Power & Wiring"
  description="Licensed Commercial Master Electricians in Virginia Beach, Norfolk, Chesapeake & 757 area. 3-phase power, commercial lighting, safety audits & data cabling. Call (757) 536-0478."
  serviceName="Commercial Electrical"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🏢 Commercial & Industrial Power
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Commercial Electrical <br />
            <span class="gold-gradient-text">Contracting Services</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            From retail buildouts to office lighting retrofits, 3-phase electrical panel upgrades, access control systems, and priority commercial emergency dispatch in Hampton Roads.
          </p>
          <div class="mt-8 flex gap-4">
            <a href="tel:7575360478" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Request Commercial Quote →
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/business_office_workspace_service/img_0806.webp" alt="Commercial Electrical Contracting in Hampton Roads" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Commercial AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="Who is the leading commercial electrical contractor in Hampton Roads?"
        summary="Scott's Electric LLC provides licensed commercial electrical contracting including 3-phase (120/208V & 277/480V) power distribution, retail & office tenant buildouts, high-efficiency LED retrofits, and 24/7 priority emergency dispatch across all 7 cities of 757."
        facts={[
          { label: "Commercial Response", value: "24/7 Priority (<45 mins)", highlight: true },
          { label: "Power Systems", value: "3-Phase (208V / 480V) & Transformers" },
          { label: "Tenant Buildouts", value: "Retail, Office, Restaurant, Industrial", highlight: true },
          { label: "Price Range", value: "$750 - $12,000+" },
          { label: "Licensure", value: "VA Class A Contractor" },
          { label: "Commercial Dispatch", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- Real Commercial Gallery -->
  <JobsiteGallery 
    title="Real Commercial Electrical Installations"
    subtitle="Direct photos from Scott's Electric office workspace power distribution, 3-phase panels, and commercial LED grid installations in 757."
    badge="Commercial Portfolio"
    photos={commercialGalleryPhotos}
    columns="3"
  />

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Commercial Electrical FAQ & Answers" />
</Layout>
