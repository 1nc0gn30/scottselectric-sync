---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Commercial Electrical", url: `${siteConfig.url}/services/commercial-electrical` }
];

const serviceData = {
  name: "Commercial Electrical Contracting & 3-Phase Power",
  description: "Commercial 3-phase power, retail tenant buildouts, office lighting, code compliance corrections, and 24/7 priority commercial dispatch across Hampton Roads (757).",
  url: `${siteConfig.url}/services/commercial-electrical`,
  priceRange: "Custom Commercial Quote"
};

const faqs = [
  {
    question: "What commercial electrical services does Scott's Electric provide in 757?",
    answer: "We provide 3-phase power distribution, commercial LED retrofits, retail tenant buildouts, dedicated machinery wiring, emergency lighting compliance, and industrial motor controls throughout Virginia Beach, Norfolk, Chesapeake, and Newport News."
  },
  {
    question: "Do you offer 24/7 emergency dispatch for commercial facilities in Hampton Roads?",
    answer: "Yes, we maintain priority on-call dispatch for commercial power outages, main distribution breaker trips, sparking panels, and code compliance violations."
  }
];
---

<Layout 
  title="Commercial Electrical Contractor 757 | 3-Phase Power & Wiring"
  description="Licensed Commercial Master Electricians in Virginia Beach, Norfolk, Chesapeake & 757 area. 3-phase power, commercial lighting, safety audits & data cabling. Call (757) 536-0478."
  serviceName="Commercial Electrical"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
          🏢 Commercial & Industrial Power
        </span>
        <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
          Commercial Electrical <br />
          <span class="gold-gradient-text">Contracting Services</span>
        </h1>
        <p class="mt-4 text-base text-gray-300 leading-relaxed">
          From retail buildouts to office lighting retrofits, 3-phase electrical panel upgrades, access control systems, and commercial emergency dispatch in Hampton Roads.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Commercial Electrical FAQ & Direct Answers" />
</Layout>
