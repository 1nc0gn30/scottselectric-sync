---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Whole-Home Standby Generators", url: `${siteConfig.url}/services/whole-home-generators` }
];

const serviceData = {
  name: "Whole-Home Standby Generator & Interlock Installation",
  description: "Automatic natural gas and propane standby backup generator installation with automatic transfer switches (ATS) and mechanical panel interlocks across Hampton Roads (757).",
  url: `${siteConfig.url}/services/whole-home-generators`,
  priceRange: "$5,500 - $14,000"
};

const generatorGalleryPhotos = [
  { src: '/assets/images/real/panels/img_3691.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_3805.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_power/img_4572.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_power/img_5869.webp', alt: '', title: '' },
  { src: '/assets/images/real/meters/img_5108.webp', alt: '', title: '' },
  { src: '/assets/images/real/work_van_and_tools/img_4539.webp', alt: '', title: '' }
];

const faqs = [
  {
    question: "How quickly does an automatic standby generator restore power during a hurricane outage?",
    answer: "An automatic standby generator senses utility voltage loss and transfers whole-house or essential-circuit loads in under 10 seconds via an Automatic Transfer Switch (ATS)."
  },
  {
    question: "Do you also install mechanical generator interlock kits and exterior power inlets?",
    answer: "Yes. In addition to turnkey automatic Generac and Kohler standby units, we install UL-listed brass mechanical breaker interlocks and NEMA 3R 30A/50A power inlet boxes to prevent hazardous utility backfeeding."
  },
  {
    question: "What standby generator brands do you install in Virginia Beach & 757?",
    answer: "We wire and commission Generac Guardian, Kohler, Cummins, and Briggs & Stratton natural gas and liquid propane standby systems with full municipal permits."
  }
];
---

<Layout
  title="Whole-Home Standby Generator, ATS & Interlock Installation in 757 | Scott's Electric"
  description="Automatic standby generator, transfer switch (ATS) & breaker interlock installation across Virginia Beach, Norfolk, Chesapeake & 757. Hurricane backup power. Call (757) 536-0478."
  serviceName="Whole-Home Standby Generators"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
            Automatic Transfer Switches (ATS) • Mechanical Panel Interlocks
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Whole-Home Standby <span class="gold-gradient-text">Generator Installation in 757</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Protect HVAC heat pumps, refrigeration, sump pumps, and home medical equipment from coastal hurricanes and Nor'easters with automatic standby power, NEMA 3R transfer switches, and code-compliant breaker interlocks.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
              Call Generator Line: (757) 536-0478
            </a>
            <a href="#quote" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-6 py-3.5 rounded-2xl text-sm">
              Estimate Backup Power ↓
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 bento-card rounded-3xl overflow-hidden vf-corners">
          <img
            src="/assets/images/real/panels/img_3691.webp"
            alt="Flush-mounted Siemens main-lug panel in textured drywall featuring brass mechanical breaker interlocks and red-taped 240-volt conductors"
            class="w-full aspect-[4/4.3] object-cover object-[47%_50%]"
          />
        </div>
      </div>

      <AEODirectAnswer
        question="How does standby generator and transfer switch installation work in Hampton Roads?"
        summary="Scott's Electric LLC installs 14kW to 26kW+ Generac and Kohler standby generators paired with 200A service-rated Automatic Transfer Switches (ATS), as well as UL-listed mechanical breaker interlocks for portable backup systems—handling NEC Article 702 load management, grounding, and municipal permits across all 7 cities."
        facts={[
          { label: "Transfer Speed", value: "< 10 Seconds (Automatic ATS)", highlight: true },
          { label: "Fuel Types", value: "Natural Gas or Propane (LP)" },
          { label: "Interlock Options", value: "ATS + Brass Panel Interlocks", highlight: true },
          { label: "Turnkey Standby Range", value: "$5,500 – $14,000" },
          { label: "Code Compliance", value: "NEC Article 702 Certified" },
          { label: "24/7 Dispatch", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <JobsiteGallery
    title="Verified Interlock Panels, Exterior NEMA 3R Gear & Service Entrances"
    subtitle="Real field photographs of brass mechanical breaker interlocks, exterior 200A service panels, NEMA 3R disconnects, and multi-meter distribution."
    badge="Backup Power Infrastructure"
    photos={generatorGalleryPhotos}
    columns="3"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Standby Generator & Transfer Switch FAQs (757)" />
</Layout>
