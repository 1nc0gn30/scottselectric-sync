---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Whole Home Generators", url: `${siteConfig.url}/services/whole-home-generators` }
];

const serviceData = {
  name: "Whole-Home Standby Generator Installation",
  description: "Automatic natural gas and propane standby backup generator installation with automatic transfer switch (ATS) for storm resilience across Hampton Roads (757).",
  url: `${siteConfig.url}/services/whole-home-generators`,
  priceRange: "$5,500 - $14,000"
};

const generatorGalleryPhotos = [
  {
    src: '/assets/images/real/outdoor_power/img_5869.webp',
    alt: "Outdoor Disconnect Switch",
    title: "Outdoor Power & Disconnects",
    category: "Outdoor Power",
    desc: "Outdoor disconnect box and conduit wiring."
  },
  {
    src: '/assets/images/real/meters/img_5108.webp',
    alt: "Electric Meter Base and Service Entrance",
    title: "Meters & Service Entrances",
    category: "Service Entrance",
    desc: "Electric meter base and utility service connection."
  },
  {
    src: '/assets/images/real/panels/img_3369.webp',
    alt: "Electrical Subpanel Installation",
    title: "Electrical Subpanels",
    category: "Panels",
    desc: "Subpanel installation and circuit wiring."
  },
  {
    src: '/assets/images/real/outdoor_power/img_4572.webp',
    alt: "Outdoor Power & Disconnect Installation",
    title: "Outdoor Power & Disconnects",
    category: "Outdoor Power",
    desc: "Exterior electrical disconnect and conduit feed."
  },
  {
    src: '/assets/images/real/panels/img_4251.webp',
    alt: "Electrical Panel Breaker Installation",
    title: "Electrical Panels",
    category: "Panels",
    desc: "Panel installation with dedicated circuit runs."
  },
  {
    src: '/assets/images/real/work_van_and_tools/img_4539.webp',
    alt: "Service Van and Tools",
    title: "Service Vans & Tools",
    category: "Equipment",
    desc: "Equipped service vehicle with electrical tooling and diagnostic gear."
  }
];

const faqs = [
  {
    question: "How quickly does a whole-home standby generator turn on during a power outage?",
    answer: "An automatic standby generator detects grid loss and restores whole-house electrical power in under 10 seconds through an automated transfer switch (ATS)."
  },
  {
    question: "Do whole-home generators run on natural gas or propane?",
    answer: "We install standby generators configured for your home's existing natural gas utility line or dedicated liquid propane (LP) tanks for uninterrupted fuel supply during severe weather."
  },
  {
    question: "What generator brands does Scott's Electric install in Virginia Beach & Hampton Roads?",
    answer: "We install and service Generac Guardian series, Kohler, Cummins, and Briggs & Stratton automatic standby generators with comprehensive manufacturer warranties."
  }
];
---

<Layout 
  title="Whole-Home Standby Generator Installation 757 | Coastal Storm Power"
  description="Automatic standby natural gas & propane generator installation in Virginia Beach, Norfolk, Chesapeake & 757 area. Automatic transfer switches & hurricane prep. Call (757) 536-0478."
  serviceName="Whole-Home Generators"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🔋 Storm Outage Resilience
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Whole-Home Standby <br />
            <span class="gold-gradient-text">Generator Installation</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Never lose power during coastal storms, Nor'easters, or hurricanes. Automatic backup power for your central heat pump, refrigeration, lights, and medical devices across Hampton Roads.
          </p>
          <div class="mt-8 flex gap-4">
            <a href="tel:7575360478" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Request Generator Consultation →
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/outdoor_power/img_4572.webp" alt="Whole-Home Generator Installation in Hampton Roads" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Generator AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="How does whole-home standby generator installation work in Hampton Roads?"
        summary="Scott's Electric installs turnkey Generac and Kohler standby generators (14kW to 26kW+) connected to an Automatic Transfer Switch (ATS). When utility power drops during a storm, the generator automatically starts and restores power to your entire home in under 10 seconds."
        facts={[
          { label: "Power Restoration", value: "<10 Seconds (Automatic)", highlight: true },
          { label: "Fuel Options", value: "Natural Gas or Propane (LP)" },
          { label: "Leading Brands", value: "Generac, Kohler, Cummins", highlight: true },
          { label: "Price Range", value: "$5,500 - $14,000 Turnkey" },
          { label: "Storm Prep", value: "Hurricane & Nor'easter Ready" },
          { label: "Consultation Line", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- Real Generator Gallery -->
  <JobsiteGallery 
    title="Real Generator & Transfer Switch Installations"
    subtitle="Direct photos from Scott's Electric standby generator hookups, utility meter integrations, and heavy-duty disconnects in 757."
    badge="Backup Power Portfolio"
    photos={generatorGalleryPhotos}
    columns="3"
  />

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Standby Generator FAQ & Direct Answers" />
</Layout>
