---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Smart Home Automation", url: `${siteConfig.url}/services/smart-home-automation` }
];

const serviceData = {
  name: "Smart Home Automation & Electrical Integration",
  description: "Smart switches, whole-home energy monitoring, automated panel relays, and intelligent connected electrical devices across Hampton Roads (757).",
  url: `${siteConfig.url}/services/smart-home-automation`,
  priceRange: "$350 - $2,500"
};

const smartGalleryPhotos = [
  {
    src: '/assets/images/real/switches/img_2677.webp',
    alt: "Switches and Wall Controls",
    title: "Switches & Controls",
    category: "Switches",
    desc: "Wall switches, dimmers, and control device wiring."
  },
  {
    src: '/assets/images/real/ceiling_lights/img_2847.webp',
    alt: "Recessed Ceiling Lights",
    title: "Ceiling Lights",
    category: "Lighting",
    desc: "Recessed ceiling lights and lighting zones."
  },
  {
    src: '/assets/images/real/chandeliers/img_3150.webp',
    alt: "Chandelier and Lighting Installation",
    title: "Chandeliers",
    category: "Lighting",
    desc: "Modern chandelier fixture mounting and dimming."
  },
  {
    src: '/assets/images/real/outdoor_lights/img_3102.webp',
    alt: "Outdoor Wall Light Fixture",
    title: "Outdoor Lights",
    category: "Outdoor Lighting",
    desc: "Exterior landscape and wall lighting fixtures."
  },
  {
    src: '/assets/images/real/panels/img_3246.webp',
    alt: "Circuit Breaker Electrical Panel",
    title: "Electrical Panels",
    category: "Panels",
    desc: "Electrical breaker panel installation and power distribution."
  },
  {
    src: '/assets/images/real/scotts_electric_employee_in_action/img_2651.webp',
    alt: "Scott's Electric Technician at Work",
    title: "Electrician on the Job",
    category: "Field Work",
    desc: "Electrical testing, troubleshooting, and device setup."
  }
];

const faqs = [
  {
    question: "Which smart home electrical systems do you install in 757?",
    answer: "We install and configure Lutron Caséta, Leviton Decora Smart, smart energy monitor panels (Span, Emporia), automated thermostats, and smart load controllers."
  },
  {
    question: "Do smart switches require a neutral wire?",
    answer: "Most modern smart switches require a dedicated neutral wire. If your home has older 2-wire switch boxes, Scott's Electric can install neutral bypass systems or pull new neutral conductors safely."
  }
];
---

<Layout 
  title="Smart Home Automation & Electrical Integration Electrician 757"
  description="Smart switches, automated climate, voice-controlled lighting & home security installations in Virginia Beach, Norfolk, Chesapeake & 757 area. Call (757) 536-0478."
  serviceName="Smart Home Automation"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            📱 Smart Connected Living
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Smart Home <br />
            <span class="gold-gradient-text">Automation & Control</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Control lights, thermostats, access control, and cameras seamlessly from your smartphone or voice assistant. Professional electrical integration across all 7 cities of 757.
          </p>
          <div class="mt-8 flex gap-4">
            <a href="tel:7575360478" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Schedule Smart Home Consultation →
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/switches/img_2677.webp" alt="Smart Home Electrical Switch and Automation in Hampton Roads" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Smart Home AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="How does professional smart home electrical automation work?"
        summary="Scott's Electric installs intelligent Lutron Caseta and Leviton smart switches, automated scene dimmers, neutral wire retrofits, and Span/Emporia whole-home energy monitoring systems, enabling voice and mobile control without Wi-Fi dropouts or electrical overloads."
        facts={[
          { label: "Protocols Supported", value: "Lutron Clear Connect, Zigbee, Z-Wave", highlight: true },
          { label: "Neutral Wire Retrofit", value: "Safe Solutions for Older Homes" },
          { label: "Panel Monitoring", value: "Span & Emporia Energy Tracking", highlight: true },
          { label: "Price Range", value: "$350 - $2,500" },
          { label: "Voice Ecosystems", value: "Apple Home, Alexa, Google Home" },
          { label: "Direct Phone", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- Real Smart Automation Gallery -->
  <JobsiteGallery 
    title="Real Smart Automation & Control Projects"
    subtitle="Direct photos from Scott's Electric smart dimmer installations, recessed LED zone automation, and smart panel integrations."
    badge="Smart Integrations"
    photos={smartGalleryPhotos}
    columns="3"
  />

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Smart Home Automation FAQ & Answers" />
</Layout>
