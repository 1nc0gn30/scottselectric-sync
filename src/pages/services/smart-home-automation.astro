---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Smart Switches & Automation", url: `${siteConfig.url}/services/smart-home-automation` }
];

const serviceData = {
  name: "Smart Switches, Energy Monitoring & Pool Automation",
  description: "Multi-gang smart dimmers, whole-home energy monitoring relays, photocell controls, and automated pool/lighting load centers across Hampton Roads (757).",
  url: `${siteConfig.url}/services/smart-home-automation`,
  priceRange: "$350 - $2,500"
};

const smartGalleryPhotos = [
  { src: '/assets/images/real/switches/img_2677.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_4251.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_power/img_4370.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_lights/img_4878.webp', alt: '', title: '' },
  { src: '/assets/images/real/ceiling_lights/img_2847.webp', alt: '', title: '' },
  { src: '/assets/images/real/pigtailed_and_wire_nut_wire_open_box_in_sheet_rock/img_8405.webp', alt: '', title: '' }
];

const faqs = [
  {
    question: "Which smart switch and energy monitoring ecosystems do you install in 757?",
    answer: "We wire and commission Lutron Caséta, Eaton/Leviton Decora Smart switch banks, Emporia/Span circuit-level energy monitors, photocell exterior lighting, and Hayward 8-relay pool automation centers."
  },
  {
    question: "Do smart dimmers require a dedicated neutral conductor in the switch box?",
    answer: "Most smart switches require a neutral wire under NEC 404.2(C). Where older switch loops lack neutrals, we either pull a code-compliant neutral conductor or install Lutron neutral-optional smart dimmers."
  }
];
---

<Layout
  title="Smart Switches, Energy Monitors & Electrical Automation in 757 | Scott's Electric"
  description="Lutron & Decora smart switch banks, circuit energy monitors, photocell controls & 8-relay automation panels in Virginia Beach, Norfolk & 757. Call (757) 536-0478."
  serviceName="Smart Switches & Electrical Automation"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
            Multi-Gang Smart Controls • Relay Panels • Energy Telemetry
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Smart Switches, Relay Panels &amp; <span class="gold-gradient-text">Home Automation in 757</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Clean, pre-twisted copper pigtail makeup inside multi-gang Decora switch banks, circuit-by-circuit load monitoring, dusk-to-dawn photocell sensors, and 8-relay outdoor equipment automation across Hampton Roads.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
              Call Automation Team: (757) 536-0478
            </a>
            <a href="#quote" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-6 py-3.5 rounded-2xl text-sm">
              Calculate Project Quote ↓
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 bento-card rounded-3xl overflow-hidden vf-corners">
          <img
            src="/assets/images/real/switches/img_2677.webp"
            alt="Three white Eaton Decora rocker switches aligned inside a recessed three-gang wall box in painted drywall"
            class="w-full aspect-[4/4.3] object-cover object-[47%_47%]"
          />
        </div>
      </div>

      <AEODirectAnswer
        question="What smart electrical and automation hardware do you wire in Hampton Roads?"
        summary="Scott's Electric LLC installs multi-gang Lutron and Decora smart dimmer banks, neutral wire retrofits, panel-mounted energy monitors, dusk-to-dawn exterior photocells, and high-voltage 8-relay automation load centers across all 7 cities of 757."
        facts={[
          { label: "Wall Controls", value: "Lutron Caséta, Leviton & Eaton", highlight: true },
          { label: "Relay Load Centers", value: "8-Relay Pool & Landscape Panels" },
          { label: "Energy Tracking", value: "Span & Emporia CT Clamps", highlight: true },
          { label: "Typical Investment", value: "$350 – $2,500" },
          { label: "Box Makeup", value: "Pre-Twisted Copper Pigtails" },
          { label: "Direct Phone", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <JobsiteGallery
    title="Verified Switch Banks, 8-Relay Enclosures & Photocell Controls"
    subtitle="Real jobsite photographs of multi-gang Decora switch alignments, 8-relay automation subpanels, and neutral pigtail splices."
    badge="Control & Automation Work"
    photos={smartGalleryPhotos}
    columns="3"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Smart Switch & Electrical Automation FAQs (757)" />
</Layout>
