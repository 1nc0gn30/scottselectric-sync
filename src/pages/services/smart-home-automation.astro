---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Smart Home Automation", url: `${siteConfig.url}/services/smart-home-automation` }
];

const serviceData = {
  name: "Smart Home Automation & Electrical Integration",
  description: "Smart switches, whole-home energy monitoring, automated panel relays, and intelligent connected electrical devices across Hampton Roads (757).",
  url: `${siteConfig.url}/services/smart-home-automation`,
  priceRange: "$350 - $2,500"
};

const faqs = [
  {
    question: "Which smart home electrical systems do you install in 757?",
    answer: "We install and configure Lutron Caséta, Leviton Decora Smart, smart energy monitor panels (Span, Emporia), automated thermostats, and smart load controllers."
  },
  {
    question: "Do smart switches require a neutral wire?",
    answer: "Most modern smart switches require a dedicated neutral wire. If your home has older 2-wire switch boxes, Scott's Electric can install neutral bypass systems or pull new neutral conductors safely."
  }
];
---

<Layout 
  title="Smart Home Automation & Electrical Integration Electrician 757"
  description="Smart switches, automated climate, voice-controlled lighting & home security installations in Virginia Beach, Norfolk, Chesapeake & 757 area. Call (757) 536-0478."
  serviceName="Smart Home Automation"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
          📱 Smart Connected Living
        </span>
        <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
          Smart Home <br />
          <span class="gold-gradient-text">Automation & Control</span>
        </h1>
        <p class="mt-4 text-base text-gray-300 leading-relaxed">
          Control lights, thermostats, access control, and cameras seamlessly from your smartphone or voice assistant. Professional electrical integration across all 7 cities of 757.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Smart Home Automation FAQ & Answers" />
</Layout>
