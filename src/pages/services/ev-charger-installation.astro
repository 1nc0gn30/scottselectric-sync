---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "EV Charger Installation", url: `${siteConfig.url}/services/ev-charger-installation` }
];

const serviceData = {
  name: "Level 2 EV Charging Station Installation",
  description: "Certified Level 2 home & commercial EV charger installations for Tesla, Rivian, Ford, Chevy, and all electric vehicles across Hampton Roads (757).",
  url: `${siteConfig.url}/services/ev-charger-installation`,
  priceRange: "$650 - $1,500"
};

const evGalleryPhotos = [
  {
    src: '/assets/images/real/outdoor_power/img_5869.webp',
    alt: "Exterior Weatherproof 240V Disconnect for EV Charging",
    title: "Exterior 240V Weatherproof Disconnect",
    category: "Outdoor EV Power",
    desc: "NEMA 3R outdoor rated enclosure engineered for coastal humidity."
  },
  {
    src: '/assets/images/real/outdoor_outlets/img_5721.webp',
    alt: "NEMA 14-50 240V Heavy Duty Outlet Installation",
    title: "NEMA 14-50 50-Amp Receptacle",
    category: "Dedicated Receptacles",
    desc: "Commercial-grade receptacle with in-use weatherproof protection."
  },
  {
    src: '/assets/images/real/panels/img_0304.webp',
    alt: "Dedicated 50A Circuit Breaker Installation for EV Charger",
    title: "Dedicated Panel Breaker Addition",
    category: "Panel Capacity",
    desc: "Load-calculated circuit breaker installation with proper wire gauge sizing."
  },
  {
    src: '/assets/images/real/wire_raceways_neat_and_oragnized_open_walls_no_sheetrock/img_0174.webp',
    alt: "Dedicated 6/3 Romex Heavy Cable Run for EV Charging",
    title: "Heavy-Gauge Feeder Routing",
    category: "Concealed Wiring",
    desc: "Code-compliant cable anchoring through garages and basement raceways."
  },
  {
    src: '/assets/images/real/meters/img_5108.webp',
    alt: "Electrical Service Capacity and Meter Base Inspection",
    alt: "Service Entrance Capacity Audit for Fast EV Charging",
    title: "Service Entrance & Capacity Verification",
    category: "Utility Check",
    desc: "Ensuring your electrical service safely accommodates high-draw EV charging."
  },
  {
    src: '/assets/images/real/outdoor_power/img_5869.webp',
    alt: "Exterior Subpanel Disconnect for Driveway Charging Post",
    title: "Outdoor Charging Post Disconnect",
    category: "Weatherproof Power",
    desc: "NEMA 3R outdoor enclosure for detached garage and driveway charging."
  }
];

const faqs = [
  {
    question: "Which EV chargers can Scott's Electric install in 757?",
    answer: "We install all Level 2 home charging units including Tesla Universal Wall Connector, Tesla Gen 3 Wall Connector, ChargePoint Home Flex, Emporia EV Charger, Grizzl-E, Rivian Wall Charger, and Ford Charge Station Pro."
  },
  {
    question: "Do I need a 200 amp panel upgrade to install an EV charger?",
    answer: "Not necessarily. If your current 100A or 150A panel has available capacity based on our NEC Article 220 load calculation, we can install a dedicated 40A or 50A breaker. If your panel is full, we can install a subpanel or upgrade to 200A."
  },
  {
    question: "How much faster is Level 2 charging compared to a regular wall plug?",
    answer: "Level 2 charging delivers 240V power at 32A-48A, adding 30 to 50 miles of range per hour (compared to only 3-5 miles per hour with a standard 120V Level 1 wall outlet)."
  }
];
---

<Layout 
  title="Level 2 EV Charger Installation in Virginia Beach & 757 Area"
  description="Licensed Level 2 EV Charger Installation for Tesla, Rivian, Ford, Chevy in Virginia Beach, Norfolk, Chesapeake & 757 area. Dedicated 240V circuits & full permits. Call (757) 536-0478."
  serviceName="EV Charger Installation"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🚘 Clean Electric Vehicle Power
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Level 2 Home <br />
            <span class="gold-gradient-text">EV Charger Installation</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Charge your electric vehicle up to 7x faster at home. Professional Level 2 charger installation, dedicated 240V circuit wiring, permit handling, and safety inspections across all 7 cities of 757.
          </p>
          <div class="mt-8 flex gap-4">
            <a href="tel:7575360478" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Book EV Charger Installation →
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/outdoor_power/img_4370.webp" alt="Level 2 EV Charging Station Installation in Virginia Beach" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- EV Charger AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="How much does home Level 2 EV charger installation cost in Hampton Roads?"
        summary="A standard Level 2 EV charger installation by Scott's Electric costs between $650 and $1,500. This includes installing a dedicated 240V circuit (40A-60A), heavy-gauge copper wiring, conduit run to your garage or driveway, NEMA 14-50 receptacle or hardwire connector, and municipal permit sign-off."
        facts={[
          { label: "Install Duration", value: "2 to 4 Hours", highlight: true },
          { label: "Charging Speed", value: "30-50 Miles of Range / Hour" },
          { label: "Models Supported", value: "Tesla, Rivian, Ford, Chevy, All EVs", highlight: true },
          { label: "Price Range", value: "$650 - $1,500" },
          { label: "City Permits", value: "Handled for All 7 Cities" },
          { label: "Direct Booking", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <!-- Real EV & Outdoor Power Gallery -->
  <JobsiteGallery 
    title="Real EV Charger & Dedicated 240V Installations"
    subtitle="Direct photos from Scott's Electric residential EV charging setups, dedicated 240V outlets, and outdoor disconnect installations."
    badge="EV Power Work"
    photos={evGalleryPhotos}
    columns="3"
  />

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="EV Charger Installation FAQ & Direct Answers" />
</Layout>
