---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "Chandeliers, Recessed & Exterior Lighting", url: `${siteConfig.url}/services/custom-lighting-installation` }
];

const serviceData = {
  name: "High-Bay Chandelier, Recessed LED & Exterior Lighting Installation",
  description: "Two-story foyer chandelier rigging, canless LED recessed lighting, vaulted ceiling fans, and dusk-to-dawn landscape & security illumination across Hampton Roads (757).",
  url: `${siteConfig.url}/services/custom-lighting-installation`,
  priceRange: "$400 - $2,800"
};

const lightingGalleryPhotos = [
  { src: '/assets/images/real/chandeliers/img_1645.webp', alt: '', title: '' },
  { src: '/assets/images/real/chandeliers/img_0757.webp', alt: '', title: '' },
  { src: '/assets/images/real/chandeliers/img_3482.webp', alt: '', title: '' },
  { src: '/assets/images/real/chandeliers/img_5434.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_lights/img_3559.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_lights/img_0949.webp', alt: '', title: '' }
];

const faqs = [
  {
    question: "Do you hang heavy chandeliers in 2-story foyers and open-truss venues?",
    answer: "Yes. We install fan/fixture-rated structural support boxes braced directly to ceiling joists or trusses, utilizing high-reach A-frame and extension rigging for residential foyers and commercial pavilions."
  },
  {
    question: "Can LED recessed downlights be added to finished ceilings without patching drywall?",
    answer: "Yes. Canless IC-rated LED wafer downlights require precision hole-saw cutouts and fished NM-B wiring, allowing clean multi-zone ceiling illumination with minimal drywall disruption."
  },
  {
    question: "Do you install dusk-to-dawn photocell floodlights and landscape uplighting?",
    answer: "Yes. We wire weatherproof PAR38 security floodlights with automatic photocells, craftsman exterior wall sconces, and low-voltage architectural landscape uplighting."
  }
];
---

<Layout
  title="2-Story Chandelier Rigging, Recessed LED & Exterior Lighting Electrician in 757 | Scott's Electric"
  description="High-ceiling foyer chandelier installation, LED recessed lighting, vaulted ceiling fans & dusk landscape lighting in Virginia Beach, Norfolk & 757. Call (757) 536-0478."
  serviceName="Chandelier & Custom Lighting Installation"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
            2-Story Foyer Rigging • Recessed LEDs • Exterior Uplights
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Chandeliers, Recessed LED &amp; <span class="gold-gradient-text">Architectural Lighting in 757</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            From heavy crystal chandeliers in two-story foyers and open-truss waterfront pavilions to dimmable LED recessed grids, vaulted ceiling fans, and dusk-to-dawn perimeter lighting across Hampton Roads.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
              Call Lighting Team: (757) 536-0478
            </a>
            <a href="#quote" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-6 py-3.5 rounded-2xl text-sm">
              Estimate Fixture Project ↓
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 bento-card rounded-3xl overflow-hidden vf-corners">
          <img
            src="/assets/images/real/chandeliers/img_5803.webp"
            alt="Technician dressing crystal prisms on an energized multi-tier chandelier wired with metal-clad cable along exposed commercial ceiling joists"
            class="w-full aspect-[4/4.3] object-cover object-[46%_48%]"
          />
        </div>
      </div>

      <AEODirectAnswer
        question="How much does chandelier rigging and recessed LED lighting installation cost in 757?"
        summary="Custom interior and exterior lighting projects range from $400 to $2,800 depending on ceiling elevation, structural box bracing requirements, and fixture count. Every heavy chandelier and vaulted ceiling fan is mounted to UL-listed structural support hardware."
        facts={[
          { label: "High-Bay Access", value: "2-Story Foyers & Open Trusses", highlight: true },
          { label: "Recessed LEDs", value: "IC-Rated Dimmable Downlights" },
          { label: "Exterior Systems", value: "Photocell, Sconces & Uplights", highlight: true },
          { label: "Typical Investment", value: "$400 – $2,800" },
          { label: "Dimmer Controls", value: "Lutron & Eaton Multi-Gang" },
          { label: "Direct Phone", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <JobsiteGallery
    title="Verified Chandelier, Medallion & Dusk Exterior Installations"
    subtitle="Real jobsite photography from our foyer chandelier mounts, commercial truss arrays, and nighttime coastal exterior lighting projects."
    badge="Lighting Portfolio"
    photos={lightingGalleryPhotos}
    columns="3"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="Chandelier & Custom Lighting FAQs (757)" />
</Layout>
