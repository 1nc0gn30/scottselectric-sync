---
import Layout from '../../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../../components/InteractiveQuoteCalculator.jsx';
import AEOFAQ from '../../components/AEOFAQ.astro';
import JobsiteGallery from '../../components/JobsiteGallery.astro';
import AEODirectAnswer from '../../components/AEODirectAnswer.astro';
import { siteConfig } from '../../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` },
  { name: "200A & 400A Panel Upgrades", url: `${siteConfig.url}/services/electrical-panel-upgrades` }
];

const serviceData = {
  name: "200A & 400A Electrical Panel Upgrades",
  description: "Complete replacement of obsolete 100A, split-bus, or hazardous Federal Pacific/Zinsco breaker boxes with modern 200A or 400A solid-copper-busbar load centers across Hampton Roads (757).",
  url: `${siteConfig.url}/services/electrical-panel-upgrades`,
  priceRange: "$1,800 - $3,800"
};

const panelGalleryPhotos = [
  { src: '/assets/images/real/panels/img_3626.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_4523.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_3805.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_3691.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_0283.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_3369.webp', alt: '', title: '' }
];

const faqs = [
  {
    question: "When should I upgrade my electrical panel from 100A to 200A in Hampton Roads?",
    answer: "If your breakers trip frequently, you have an older split-bus panel without a single main disconnect, or you plan to add a Level 2 EV charger, heat pump, hot tub, or standby generator, upgrading to a 200A or 400A panel provides safe NEC-compliant capacity."
  },
  {
    question: "How long does an electrical panel replacement take?",
    answer: "A complete main electrical panel replacement takes 4 to 8 hours. Scott's Electric coordinates directly with Dominion Energy for the disconnect/reconnect and handles municipal inspection permits so power is restored the same day."
  },
  {
    question: "Do you replace hazardous Federal Pacific (FPE), Zinsco, and oversprayed split-bus panels?",
    answer: "Yes. Defective FPE Stab-Lok, Zinsco, and aging split-bus load centers represent serious overcurrent and fire risks. We replace them with UL-listed Siemens, Square D, or Eaton solid-copper-busbar breaker panels."
  },
  {
    question: "How much does a 200 amp panel upgrade cost in Virginia Beach, Norfolk & Chesapeake?",
    answer: "A standard 200A panel upgrade typically ranges from $1,800 to $3,800 depending on exterior meter socket condition, grounding electrode requirements, and utility service entrance conductors."
  }
];
---

<Layout
  title="200A & 400A Electrical Panel Upgrades & Breaker Box Replacement in 757 | Scott's Electric"
  description="Same-day 200A & 400A electrical panel upgrades in Virginia Beach, Norfolk, Chesapeake & all 7 cities of 757. Solid copper busbars, Dominion Energy disconnect & permits. Call (757) 536-0478."
  serviceName="200A & 400A Electrical Panel Upgrades"
  breadcrumbs={breadcrumbs}
  isServicePage={true}
  serviceData={serviceData}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
            Same-Day Utility Reconnect • Solid Copper Busbars
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            200A &amp; 400A Electrical <span class="gold-gradient-text">Panel Upgrades in 757</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Eliminate nuisance breaker trips and unlock safe 240V headroom for EV chargers, heat pumps, and modern appliances. We replace overloaded 100A panels, split-bus enclosures, and Federal Pacific/Zinsco boxes across all 7 cities of Hampton Roads.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
              Call for Panel Quote: (757) 536-0478
            </a>
            <a href="#quote" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-6 py-3.5 rounded-2xl text-sm">
              Run NEC 220 Load Check ↓
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 bento-card rounded-3xl overflow-hidden vf-corners">
          <img
            src="/assets/images/real/panels/img_4022.webp"
            alt="Open Siemens 200-amp main breaker panel featuring heavy solid copper busbars, printed conductor labels, and spare expansion spaces"
            class="w-full aspect-[4/4.3] object-cover object-[31%_48%]"
          />
        </div>
      </div>

      <AEODirectAnswer
        question="How much does a 200A electrical panel upgrade cost in Hampton Roads (757)?"
        summary="A turnkey 200A electrical panel upgrade by a licensed Master Electrician typically costs between $1,800 and $3,800. This includes a UL-listed Siemens, Square D, or Eaton load center, AFCI/GFCI breakers, grounding electrode bonding, Dominion Energy disconnect/reconnect coordination, and municipal city permits with same-day power restoration."
        facts={[
          { label: "Turnaround Time", value: "Same-Day (4–8 Hours)", highlight: true },
          { label: "Turnkey Price Range", value: "$1,800 – $3,800" },
          { label: "Utility Coordination", value: "Dominion Energy Handled", highlight: true },
          { label: "Municipal Permits", value: "All 7 Cities Filed" },
          { label: "Panel Brands", value: "Siemens, Square D, Eaton" },
          { label: "24/7 Dispatch Line", value: "(757) 536-0478" }
        ]}
        cityName="Hampton Roads (757)"
      />
    </div>
  </section>

  <JobsiteGallery
    title="Verified 200A Panel & Meter Socket Installations"
    subtitle="Real internal dead-front inspections showing solid copper busbars, insulated lug guards, AFCI arrays, exterior NEMA 3R panels, and pre-upgrade split-bus audits."
    badge="Panel Upgrade Portfolio"
    photos={panelGalleryPhotos}
    columns="3"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title="200A Electrical Panel Upgrade FAQs (757)" />
</Layout>
