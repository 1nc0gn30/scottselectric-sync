---
import Layout from '../layouts/Layout.astro';
import AEOFAQ from '../components/AEOFAQ.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Newport News Electrician", url: `${siteConfig.url}/newport-news-electrician` }
];

const newportPhotos = [
  {
    src: '/assets/images/real/panels/img_4251.webp',
    alt: "Electrical Panel Breaker Installation",
    title: "Electrical Panels",
    category: "Panels",
    desc: "Circuit breaker load center and wire management."
  },
  {
    src: '/assets/images/real/meters/img_5108.webp',
    alt: "Electrical Meter Base and Service Entrance",
    title: "Meters & Service Entrances",
    category: "Service Entrance",
    desc: "Electric meter base and utility service connection."
  },
  {
    src: '/assets/images/real/ceiling_lights/img_3486.webp',
    alt: "Recessed Ceiling Lighting Grid",
    title: "Ceiling Lights",
    category: "Lighting",
    desc: "Recessed ceiling lights and fixture layout."
  },
  {
    src: '/assets/images/real/work_van_and_tools/img_4519.webp',
    alt: "Service Van and Electrical Tools",
    title: "Service Vans & Tools",
    category: "Equipment",
    desc: "Equipped service vehicle with electrical tooling and testing gear."
  }
];

const cityFaqs = [
  {
    question: "Which Newport News areas and communities does Scott's Electric cover?",
    answer: "We provide complete electrical service and emergency dispatch across City Center at Oyster Point, Port Warwick, Hilton Village, Denbigh, Menchville, Kiln Creek, and Hidenwood."
  },
  {
    question: "Do you install whole-home surge protection in Newport News?",
    answer: "Yes, we install Type 1 and Type 2 panel-mounted surge protective devices (SPDs) to shield electronics, heat pumps, and appliances from Peninsula storm power surges."
  },
  {
    question: "How do I schedule an electrical panel replacement in Newport News?",
    answer: "Call our 24/7 line at (757) 536-0478 or use our online calculator. We handle Dominion Energy disconnect coordination and City of Newport News code permits."
  }
];
---

<Layout 
  title="Electrician in Newport News VA | 24/7 Peninsula Electrical Repair & Panels"
  description="Licensed Master Electrician in Newport News, VA serving Oyster Point, Denbigh & Hilton Village. 24/7 emergency electrical repair, 200A panel upgrades & EV chargers. Call (757) 536-0478."
  cityName="Newport News"
  serviceName="Newport News Electrical Contractor"
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🏗️ Newport News Peninsula Electrical Services
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Peninsula Electrician in <br />
            <span class="gold-gradient-text">Newport News, VA</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Serving City Center at Oyster Point, Hilton Village, Denbigh, Hidenwood, and Menchville. Scott's Electric brings fast Master Electrician dispatch to Peninsula homes and commercial facilities.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#quote" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Get Newport News Quote →
            </a>
            <a href="tel:7575360478" class="border border-brand-cyan/40 text-brand-cyan hover:bg-brand-cyan hover:text-black font-extrabold px-6 py-3 rounded-xl text-xs">
              📞 24/7 Peninsula Line: (757) 536-0478
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/panels/img_4251.webp" alt="Master Electrician in Newport News, VA" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Local AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="Need a licensed Master Electrician on the Peninsula in Newport News, VA?"
        summary="Scott's Electric delivers 24/7 emergency repair, 200A/400A panel upgrades, Level 2 EV charging stations, and commercial power solutions across Newport News, Oyster Point, Port Warwick, Hilton Village, and Denbigh."
        facts={[
          { label: "Peninsula Response", value: "35-45 Minutes", highlight: true },
          { label: "Meter Tie-Ins", value: "Dominion Energy Disconnect Coordinated" },
          { label: "City Permits", value: "Newport News Codes Compliance", highlight: true },
          { label: "Licensure", value: "VA Class A Contractor" },
          { label: "Dispatch Phone", value: "(757) 536-0478" },
          { label: "Newport News ZIPs", value: "23601, 23602, 23603, 23606, 23608" }
        ]}
        cityName="Newport News"
      />
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-8">
        Newport News Peninsula Services
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">⚡</div>
          <h3 class="font-heading text-xl font-bold text-white">200A Panel Replacement</h3>
          <p class="text-xs text-gray-300">
            Modernize outdated breaker boxes in historic Hilton Village and Denbigh homes with smart high-capacity panels.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🛡️</div>
          <h3 class="font-heading text-xl font-bold text-white">Whole-Home Surge Defense</h3>
          <p class="text-xs text-gray-300">
            Protect expensive electronics and appliances from grid instability and lightning strikes.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🚘</div>
          <h3 class="font-heading text-xl font-bold text-white">EV Charger Wiring</h3>
          <p class="text-xs text-gray-300">
            Level 2 Tesla Wall Connector and universal EV charging station setups across Newport News.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Work Gallery -->
  <JobsiteGallery 
    title="Featured Jobsite Photos"
    subtitle="Real photos of panel replacements, electric meters, recessed lighting, and field tooling."
    badge="Our Work"
    photos={newportPhotos}
    columns="4"
  />

  <section id="quote" class="py-16 bg-brand-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={cityFaqs} title="Newport News Electrical FAQ & Answers" cityName="Newport News" />
</Layout>
