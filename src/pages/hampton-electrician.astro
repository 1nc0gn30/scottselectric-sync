---
import Layout from '../layouts/Layout.astro';
import AEOFAQ from '../components/AEOFAQ.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Hampton Electrician", url: `${siteConfig.url}/hampton-electrician` }
];

const hamptonPhotos = [
  {
    src: '/assets/images/real/outdoor_lights/img_4878.webp',
    alt: "Hampton VA Architectural Coastal Exterior Lighting",
    title: "Phoebus Architectural Coastal Lighting",
    category: "Hampton",
    desc: "Weather-sealed coastal exterior fixtures for harsh salty air."
  },
  {
    src: '/assets/images/real/outdoor_power/img_4572.webp',
    alt: "Buckroe Beach Standby Generator Power Setup",
    title: "Buckroe Standby Backup Power",
    category: "Hampton",
    desc: "Automatic generator disconnect and surge protection for storm resilience."
  },
  {
    src: '/assets/images/real/pigtailed_and_wire_nut_wire_open_box_in_sheet_rock/img_8405.webp',
    alt: "Hampton Aluminum Wire Remediation and Junction Box Pigtails",
    title: "Aluminum Wire Remediation",
    category: "Hampton",
    desc: "Safe Copalum and AlumiConn connector installations in older Hampton homes."
  },
  {
    src: '/assets/images/real/panels/img_1141.webp',
    alt: "Coliseum Central Hampton 200A Breaker Panel Upgrade",
    title: "Coliseum Area Panel Modernization",
    category: "Hampton",
    desc: "Clean circuit breaker modernization with dedicated heat pump circuits."
  }
];

const cityFaqs = [
  {
    question: "Which Hampton communities does Scott's Electric serve?",
    answer: "We provide full electrical contractor services across Phoebus, Buckroe Beach, Coliseum Central, Fox Hill, Wythe, Downtown Hampton, and Langley."
  },
  {
    question: "Do you repair aluminum wiring and coastal electrical corrosion in Hampton?",
    answer: "Yes, we perform aluminum wire remediation (AlumiConn / Copalum connectors) and replace corrosion-damaged coastal meter bases and outdoor panels near Buckroe Beach and coastal waterways."
  },
  {
    question: "Can I get an automatic standby generator installed in Hampton, VA?",
    answer: "Yes, we install Generac and Kohler whole-home backup generators with automatic transfer switches to protect against storm outages across Hampton."
  }
];
---

<Layout 
  title="Electrician in Hampton VA | 24/7 Emergency Repair & Standby Generators"
  description="Top-rated licensed Master Electrician in Hampton, VA. Serving Phoebus, Buckroe Beach & Coliseum Central. 24/7 emergency repair, 200A panel upgrades & generators. Call (757) 536-0478."
  cityName="Hampton"
  serviceName="Hampton Electrical Contractor"
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🏖️ Hampton, VA Electrical Services
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Licensed Electrician in <br />
            <span class="gold-gradient-text">Hampton, Virginia</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Phoebus, Buckroe Beach, Coliseum Central, Fox Hill, and Wythe. Complete coastal residential electrical repair, panel upgrades, surge protection, and standby generator setups.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#quote" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Get Hampton Quote →
            </a>
            <a href="tel:7575360478" class="border border-brand-cyan/40 text-brand-cyan hover:bg-brand-cyan hover:text-black font-extrabold px-6 py-3 rounded-xl text-xs">
              📞 24/7 Hampton Line: (757) 536-0478
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/outdoor_lights/img_4878.webp" alt="Master Electrician in Hampton, VA" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Local AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="Looking for a certified Master Electrician in Hampton, VA?"
        summary="Scott's Electric provides emergency electrical dispatch, aluminum wiring repair, coastal weatherproofing, 200A panel upgrades, and whole-home standby generator installations across Phoebus, Buckroe Beach, Coliseum Central, and Fox Hill."
        facts={[
          { label: "Hampton Response", value: "30-45 Minutes", highlight: true },
          { label: "Aluminum Wire Fix", value: "AlumiConn / Copalum Certified" },
          { label: "Permits & Codes", value: "City of Hampton Building Division", highlight: true },
          { label: "Licensure", value: "VA Class A #2710078492" },
          { label: "Direct Phone", value: "(757) 536-0478" },
          { label: "Hampton ZIP Codes", value: "23661, 23663, 23664, 23666, 23669" }
        ]}
        cityName="Hampton"
      />
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-8">
        Hampton Electrical Solutions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🔋</div>
          <h3 class="font-heading text-xl font-bold text-white">Standby Backup Generators</h3>
          <p class="text-xs text-gray-300">
            Automatic storm backup power systems designed to withstand coastal weather and hurricanes.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">⚡</div>
          <h3 class="font-heading text-xl font-bold text-white">200A Panel Modernization</h3>
          <p class="text-xs text-gray-300">
            Upgrade obsolete fuse boxes or 100A panels to 200A or 400A smart circuit breaker boxes.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🌊</div>
          <h3 class="font-heading text-xl font-bold text-white">Coastal Weatherproofing</h3>
          <p class="text-xs text-gray-300">
            Corrosion-resistant exterior disconnects, NEMA 4X enclosures, and coastal lighting fixtures.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Work in Hampton Gallery -->
  <JobsiteGallery 
    title="Real Electrical Installations in Hampton"
    subtitle="Direct photos from coastal outdoor lighting, aluminum wiring repairs, standby generator feeds, and panel upgrades in Hampton."
    badge="Hampton Projects"
    photos={hamptonPhotos}
    columns="4"
  />

  <section id="quote" class="py-16 bg-brand-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={cityFaqs} title="Hampton Electrical FAQ & Answers" cityName="Hampton" />
</Layout>
