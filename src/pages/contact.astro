---
import Layout from '../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "24/7 Dispatch & Quote Form", url: `${siteConfig.url}/contact` }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${siteConfig.url}/contact#webpage`,
      "url": `${siteConfig.url}/contact`,
      "name": "24/7 Emergency Electrician Dispatch & Project Quote Form in 757 — (757) 536-0478",
      "description": "Call (757) 536-0478 for immediate 24/7 Master Electrician dispatch or submit our online project quote form across Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk.",
      "isPartOf": { "@id": `${siteConfig.url}/#website` },
      "about": { "@id": `${siteConfig.url}/#organization` }
    }
  ]
};
---

<Layout
  title="24/7 Emergency Electrician Dispatch & Project Quotes in 757 — (757) 536-0478 | Scott's Electric"
  description="Call (757) 536-0478 for 24/7 emergency electrical repair or request a written estimate online for 200A panel upgrades, EV chargers & standby generators across all 7 cities of 757."
  breadcrumbs={breadcrumbs}
  customSchema={[contactSchema]}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
        Immediate 24/7 Phone Dispatch • Online Project Intake
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white mt-4 leading-tight max-w-4xl mx-auto">
        24/7 Emergency Electrician Dispatch &amp; <span class="gold-gradient-text">Project Quotes in 757</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        For immediate troubleshooting, power loss, or same-day scheduling across Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk, call our 24/7 Master Electrician line directly—or complete the project form below.
      </p>

      <!-- Phone-First Dual Action Cards (Zero Mailto Distractions) -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
        <a href="tel:7575360478" class="md:col-span-2 cta-phone-beam bento-card p-6 sm:p-7 rounded-3xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:scale-[1.01] transition-transform">
          <div>
            <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-400">
              Primary 24/7 Emergency &amp; Scheduling Line
            </div>
            <div class="font-mono text-2xl sm:text-3xl font-extrabold text-white mt-1">
              (757) 536-0478
            </div>
            <div class="text-xs text-slate-300 mt-1">
              Tap to connect directly with a Virginia Master Electrician • &lt;45 min avg emergency response
            </div>
          </div>
          <span class="inline-flex items-center justify-center bg-amber-500 text-slate-950 font-extrabold text-xs px-5 py-3.5 rounded-xl shrink-0">
            Call Now →
          </span>
        </a>

        <a href="#online-quote-form" class="bento-card p-6 sm:p-7 rounded-3xl flex flex-col justify-between">
          <div>
            <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-cyan-400">
              Written Project Quotes
            </div>
            <div class="font-heading text-xl font-bold text-white mt-1">
              Online Intake Form
            </div>
            <div class="text-xs text-slate-300 mt-1">
              Calculate NEC load &amp; submit project details for a fast callback.
            </div>
          </div>
          <span class="font-mono text-xs text-amber-400 font-bold mt-4">Jump to Form ↓</span>
        </a>
      </div>

      <!-- Verified Fleet & 200A Workmanship Proof -->
      <div class="mt-14 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
        <div class="bento-card rounded-3xl overflow-hidden">
          <img
            src="/assets/images/real/work_van_and_tools/img_4519.webp"
            alt="Open rear doors of an electrical contractor cargo van stocked with cordless power tools, fish tapes, wire spools, and roof ladders"
            class="w-full h-64 object-cover object-[50%_44%]"
          />
          <div class="p-5 border-t border-slate-800">
            <span class="font-mono text-[10px] font-bold text-amber-400 uppercase tracking-wider">FLEET SERVICE VAN // TOOL INVENTORY</span>
            <h2 class="font-heading text-lg font-bold text-white mt-1">Outfitted 757 Service Vehicles</h2>
            <p class="text-xs text-slate-300 mt-1">Stocked with Siemens, Square D &amp; Eaton breakers, THHN/NM-B copper spools, conduit, and Werner ladders for single-visit completion.</p>
          </div>
        </div>
        <div class="bento-card rounded-3xl overflow-hidden">
          <img
            src="/assets/images/real/panels/img_4022.webp"
            alt="Open Siemens 200-amp main breaker panel featuring heavy solid copper busbars, printed conductor labels, and spare expansion spaces"
            class="w-full h-64 object-cover object-[31%_48%]"
          />
          <div class="p-5 border-t border-slate-800">
            <span class="font-mono text-[10px] font-bold text-cyan-400 uppercase tracking-wider">SIEMENS 200A // SOLID COPPER BUSBAR</span>
            <h2 class="font-heading text-lg font-bold text-white mt-1">VA Class A Master Workmanship</h2>
            <p class="text-xs text-slate-300 mt-1">Every installation is labeled, torque-checked, and coordinated with Dominion Energy and municipal building inspectors.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="online-quote-form" class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>
</Layout>
