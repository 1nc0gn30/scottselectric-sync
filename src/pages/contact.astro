---
import Layout from '../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Contact", url: `${siteConfig.url}/contact` }
];

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": `${siteConfig.url}/contact#webpage`,
      "url": `${siteConfig.url}/contact`,
      "name": "Contact Scott's Electric | 24/7 Dispatch (757) 536-0478",
      "description": "Contact Scott's Electric for 24/7 emergency repair, panel upgrades, EV chargers, or instant estimates across Virginia Beach, Norfolk, Chesapeake, and all 7 cities.",
      "isPartOf": { "@id": `${siteConfig.url}/#website` },
      "about": { "@id": `${siteConfig.url}/#organization` }
    }
  ]
};
---

<Layout 
  title="Contact Scott's Electric | 24/7 Emergency Dispatch (757) 536-0478"
  description="Contact Scott's Electric for 24/7 emergency electrical repair, panel upgrades, EV chargers, or free estimates across Virginia Beach, Norfolk, Chesapeake, and all 7 cities."
  breadcrumbs={breadcrumbs}
  customSchema={[contactSchema]}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
        24/7 Dispatch & Inquiries
      </span>
      <h1 class="font-heading text-4xl sm:text-6xl font-extrabold text-white mt-4">
        Contact <span class="gold-gradient-text">Scott's Electric</span>
      </h1>
      <p class="mt-4 text-base text-gray-300 max-w-2xl mx-auto">
        Need an electrician fast or planning an upcoming installation? Connect with our team serving all 7 cities of 757.
      </p>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <a href="tel:7575360478" class="glass-panel p-6 rounded-2xl border border-gray-800 hover:border-brand-gold transition-all text-center">
          <div class="text-3xl mb-2">📞</div>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-gold">Call / Text 24/7</div>
          <div class="text-lg font-extrabold text-white mt-1">(757) 536-0478</div>
        </a>
        <a href="mailto:info@scottselectric.pro" class="glass-panel p-6 rounded-2xl border border-gray-800 hover:border-brand-gold transition-all text-center">
          <div class="text-3xl mb-2">✉️</div>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-cyan">Email Support</div>
          <div class="text-sm font-bold text-white mt-1">info@scottselectric.pro</div>
        </a>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 text-center">
          <div class="text-3xl mb-2">📍</div>
          <div class="text-xs font-bold uppercase tracking-wider text-brand-gold">Service Area</div>
          <div class="text-sm font-bold text-white mt-1">All 7 Cities of 757</div>
        </div>
      </div>

      <!-- Real Fleet & Rapid Dispatch Showcase -->
      <div class="mt-14 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 items-center text-left">
        <div class="relative rounded-3xl overflow-hidden glass-panel border border-gray-800 shadow-card">
          <img 
            src="/assets/images/real/work_van_and_tools/img_4539.webp" 
            alt="Scott's Electric Fully Stocked Service Fleet" 
            class="w-full h-64 object-cover"
          />
          <div class="p-4 bg-brand-card/90 border-t border-gray-800">
            <span class="text-xs font-bold text-brand-gold uppercase tracking-wider">Fully Stocked Field Fleet</span>
            <p class="text-xs text-gray-300 mt-1">Ready with commercial-grade meters, circuit breakers, wiring, and conduit for same-day repairs.</p>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden glass-panel border border-gray-800 shadow-card">
          <img 
            src="/assets/images/real/scotts_electric_employee_in_action/img_2651.webp" 
            alt="Scott's Electric Master Electrician On-Site" 
            class="w-full h-64 object-cover"
          />
          <div class="p-4 bg-brand-card/90 border-t border-gray-800">
            <span class="text-xs font-bold text-brand-cyan uppercase tracking-wider">Licensed Master Electricians</span>
            <p class="text-xs text-gray-300 mt-1">On-call 24 hours a day, 365 days a year for immediate emergency response in all 7 cities.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>
</Layout>
