---
import Layout from '../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Services", url: `${siteConfig.url}/services` }
];

const allServices = [
  { 
    title: "Electrical Panel Upgrades (200A/400A)", 
    img: "/assets/images/real/panels/img_4251.webp",
    desc: "Upgrade obsolete fuse boxes or 100A panels to modern high-capacity smart breaker boxes.", 
    link: "/services/electrical-panel-upgrades" 
  },
  { 
    title: "EV Charging Station Installation", 
    img: "/assets/images/real/outdoor_power/img_4370.webp",
    desc: "Level 2 chargers for Tesla, Rivian, Ford Lightning, and all EV makes in residential & commercial sites.", 
    link: "/services/ev-charger-installation" 
  },
  { 
    title: "Whole-Home Backup Generator Setup", 
    img: "/assets/images/real/outdoor_power/img_4572.webp",
    desc: "Automatic gas/propane standby power systems for coastal storm outage protection.", 
    link: "/services/whole-home-generators" 
  },
  { 
    title: "Custom & Recessed Architectural Lighting", 
    img: "/assets/images/real/chandeliers/img_5803.webp",
    desc: "LED recessed spotlights, custom grand chandeliers, under-cabinet strips, and dimming switches.", 
    link: "/services/custom-lighting-installation" 
  },
  { 
    title: "Smart Home Automation Systems", 
    img: "/assets/images/real/switches/img_2677.webp",
    desc: "Integrated smart switches, automated climate, voice control, and smartphone remote access.", 
    link: "/services/smart-home-automation" 
  },
  { 
    title: "Commercial Electrical & 3-Phase Power", 
    img: "/assets/images/real/business_office_workspace_service/img_0806.webp",
    desc: "Retail, office, restaurant, and industrial electrical wiring, lighting maintenance, and power.", 
    link: "/services/commercial-electrical" 
  },
  { 
    title: "Ceiling Fans & Recessed LED Lighting", 
    img: "/assets/images/real/ceiling_fans/img_4926.webp",
    desc: "Safe fixture hanging, fan-rated boxes, speed controls, and ultra-thin LED wafer installs.", 
    link: "/services/custom-lighting-installation" 
  },
  { 
    title: "Outdoor Outlets & Weatherproof Power", 
    img: "/assets/images/real/outdoor_outlets/img_5721.webp",
    desc: "In-use weatherproof GFCI receptacles, exterior disconnects, and coastal power points.", 
    link: "/services" 
  },
  { 
    title: "Pool, Hot Tub & Spa Wiring", 
    img: "/assets/images/real/outdoor_power/img_5869.webp",
    desc: "GFCI protected subpanels, bonding grids, underwater LED lighting, and automatic heaters.", 
    link: "/services" 
  },
  { 
    title: "Whole-Home Surge Protection & Meter Bases", 
    img: "/assets/images/real/meters/img_5108.webp",
    desc: "Suppress lightning spikes, utility line surges, and modernize exterior service entrance equipment.", 
    link: "/services" 
  },
  { 
    title: "Emergency Electrical Repairs 24/7", 
    img: "/assets/images/real/scotts_electric_employee_in_action/img_2651.webp",
    desc: "Immediate dispatch for burning smells, tripping main breakers, or total power failure.", 
    link: "/services" 
  },
  { 
    title: "Electrical Safety Inspections & Audits", 
    img: "/assets/images/real/panels/img_1141.webp",
    desc: "Comprehensive home buyer and code compliance safety inspections with digital reports.", 
    link: "/services" 
  }
];

const serviceShowcasePhotos = [
  {
    src: '/assets/images/real/panels/img_3369.webp',
    alt: "Dual Subpanel Replacement and Clean Wire Management",
    title: "High-Capacity Dual Subpanels",
    category: "Panel Upgrades",
    desc: "Balanced phase distribution and clean circuit separation."
  },
  {
    src: '/assets/images/real/chandeliers/img_0757.webp',
    alt: "Modern Multi-Tier Chandelier Installation",
    title: "Modern Architectural Chandelier",
    category: "Lighting Fixtures",
    desc: "Custom ceiling support and dimmable ambiance."
  },
  {
    src: '/assets/images/real/outdoor_lights/img_4878.webp',
    alt: "Exterior Architectural Coach Lighting",
    title: "Exterior Coach & Accent Lights",
    category: "Outdoor Lighting",
    desc: "Weather-sealed coastal fixtures for curb appeal and security."
  },
  {
    src: '/assets/images/real/ceiling_lights/img_2739.webp',
    alt: "Recessed Wafer LED Ceiling Lighting",
    title: "Recessed Wafer LED Layout",
    category: "LED Retrofits",
    desc: "Evenly distributed, high-CRI illumination for modern interiors."
  },
  {
    src: '/assets/images/real/outdoor_outlets/img_5884.webp',
    alt: "Weatherproof GFCI Outdoor Outlet Box",
    title: "Outdoor Weatherproof Receptacles",
    category: "Exterior Power",
    desc: "Heavy-duty in-use bubble covers and wet-rated GFCI protection."
  },
  {
    src: '/assets/images/real/work_van_and_tools/img_4519.webp',
    alt: "Scott's Electric Mobile Service Unit",
    title: "Mobile Service Unit Ready 24/7",
    category: "Rapid Dispatch",
    desc: "Equipped for same-day repairs and major upgrades across all 7 cities."
  }
];
---

<Layout 
  title="Electrical Services | Scott's Electric (Hampton Roads 757)"
  description="Full-service licensed Master Electrician solutions across all 7 cities of 757. 200A panel upgrades, EV chargers, standby generators, custom lighting, smart home, and commercial electrical."
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
        Comprehensive Electrical Solutions
      </span>
      <h1 class="font-heading text-4xl sm:text-6xl font-extrabold text-white mt-4">
        Our <span class="gold-gradient-text">Electrical Services</span>
      </h1>
      <p class="mt-4 text-base text-gray-300 max-w-3xl mx-auto">
        Serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk with licensed Master Electrician quality.
      </p>

      <!-- Services Overview AEO Direct Answer Block -->
      <div class="mt-10 max-w-4xl mx-auto text-left">
        <AEODirectAnswer 
          question="What electrical services does Scott's Electric provide across Hampton Roads?"
          summary="Scott's Electric offers comprehensive residential, commercial, and emergency electrical services including 200A/400A panel upgrades, Level 2 EV charging stations, whole-home standby generator installations, custom LED lighting, smart home automation, and 24/7 priority emergency dispatch across all 7 cities of 757."
          facts={[
            { label: "Emergency Repair", value: "24/7 Priority Dispatch (<45 mins)", highlight: true },
            { label: "Panel Upgrades", value: "200A & 400A Smart Panels" },
            { label: "EV Charging", value: "Tesla, NACS, J1772 Level 2", highlight: true },
            { label: "Generators", value: "Generac & Kohler Backup Systems" },
            { label: "Service Area", value: "All 7 Cities of 757" },
            { label: "Licensure", value: "VA Class A Contractor" }
          ]}
          cityName="Hampton Roads (757)"
        />
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allServices.map(srv => (
          <div class="group glass-panel rounded-3xl overflow-hidden border border-gray-800 hover:border-brand-gold/50 transition-all duration-300 shadow-card flex flex-col justify-between">
            <div>
              <div class="relative h-48 overflow-hidden bg-brand-card">
                <img 
                  src={srv.img} 
                  alt={srv.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
              </div>
              <div class="p-6">
                <h3 class="font-heading text-xl font-bold text-white group-hover:text-brand-amber transition-colors mb-2">{srv.title}</h3>
                <p class="text-xs text-gray-300 leading-relaxed mb-4">{srv.desc}</p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <a href={srv.link} class="text-xs font-bold text-brand-gold hover:underline flex items-center justify-between border-t border-gray-800/80 pt-4">
                <span>View Service Details</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Jobsite Gallery Section -->
  <JobsiteGallery 
    title="Real Electrical Installations Across 757"
    subtitle="Direct photos from Scott's Electric service calls, panel replacements, chandelier hanging, and outdoor power installations."
    badge="Field Proof"
    photos={serviceShowcasePhotos}
    columns="3"
  />

  <section class="py-16 bg-brand-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

</Layout>
