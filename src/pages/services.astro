---
import Layout from '../layouts/Layout.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Electrical Services", url: `${siteConfig.url}/services` }
];

const allServices = [
  {
    title: "200A & 400A Electrical Panel Upgrades",
    img: "/assets/images/real/panels/img_4022.webp",
    alt: "Open Siemens 200-amp main breaker panel featuring heavy solid copper busbars and printed conductor labels",
    fx: "31% 48%",
    desc: "Replace overloaded 100A panels, split-bus boxes, or FPE/Zinsco hazards with solid-copper-busbar 200A/400A load centers.",
    link: "/services/electrical-panel-upgrades"
  },
  {
    title: "Level 2 EV Charger Circuits (240V)",
    img: "/assets/images/real/panels/img_5010.webp",
    alt: "Open NEMA 3R Square D Homeline 200-amp exterior main-breaker panel with dedicated 240-volt branch wiring",
    fx: "48% 50%",
    desc: "Dedicated 40A–60A 240V circuits for Tesla Wall Connector, NACS, Rivian, Ford, and NEMA 14-50 charging stations.",
    link: "/services/ev-charger-installation"
  },
  {
    title: "Whole-Home Standby Generators & Interlocks",
    img: "/assets/images/real/panels/img_3691.webp",
    alt: "Flush-mounted Siemens panel featuring brass mechanical breaker interlocks and red-taped 240-volt conductors",
    fx: "47% 50%",
    desc: "Automatic standby natural gas & propane generators, automatic transfer switches (ATS), and mechanical interlock kits.",
    link: "/services/whole-home-generators"
  },
  {
    title: "Chandeliers, Recessed & Landscape Lighting",
    img: "/assets/images/real/chandeliers/img_5803.webp",
    alt: "Technician dressing crystal prisms on an energized multi-tier chandelier wired with metal-clad cable",
    fx: "46% 48%",
    desc: "Two-story foyer chandelier rigging, canless LED recessed downlights, ceiling medallions, and dusk exterior uplights.",
    link: "/services/custom-lighting-installation"
  },
  {
    title: "Smart Switches, Dimmers & Energy Monitors",
    img: "/assets/images/real/switches/img_2677.webp",
    alt: "Three white Eaton Decora rocker switches aligned inside a recessed three-gang wall box",
    fx: "47% 47%",
    desc: "Multi-gang Decora/Lutron smart dimmers, neutral wire retrofits, and Span/Emporia panel energy monitoring.",
    link: "/services/smart-home-automation"
  },
  {
    title: "Commercial 3-Phase Distribution & Meter Banks",
    img: "/assets/images/real/panels/img_4537.webp",
    alt: "Twin Square D three-phase main-lug subpanels framed in wood studs with PVC feeder conduits and MC cables",
    fx: "50% 46%",
    desc: "Square D I-Line & NQ bolt-on 3-phase switchgear, parallel EMT offsets, NEMA 3R fusible switches, and tenant buildouts.",
    link: "/services/commercial-electrical"
  },
  {
    title: "NEC 680 Swimming Pool & Hot Tub Subpanels",
    img: "/assets/images/real/outdoor_power/img_4370.webp",
    alt: "Outdoor Hayward pool automation subpanel, salt chlorinator controller, Schedule 40 PVC conduits, and GFCI outlet",
    fx: "52% 50%",
    desc: "Hayward/Pentair automation subpanels, 8-relay load centers, salt chlorinator transformers, and equipotential bonding.",
    link: "#quote"
  },
  {
    title: "Vaulted Ceiling Fans & Exhaust Luminaires",
    img: "/assets/images/real/ceiling_fans/img_3327.webp",
    alt: "Six-blade gunmetal ceiling fan with dark woodgrain blades and integrated frosted LED drum light",
    fx: "49% 41%",
    desc: "Fan-rated structural boxes, extended vaulted ceiling downrods, wall speed controls, and bathroom exhaust luminaires.",
    link: "/services/custom-lighting-installation"
  },
  {
    title: "Utility Meter Sockets & Exterior Disconnects",
    img: "/assets/images/real/meters/img_5108.webp",
    alt: "Six-position horizontal electric meter socket trough feeding five exterior General Electric load centers on brick wall",
    fx: "45% 49%",
    desc: "Single and multi-gang ringless meter bases, Noalox aluminum terminations, NEMA 3R disconnects, and Dominion tie-ins.",
    link: "/services/electrical-panel-upgrades"
  },
  {
    title: "Weatherproof Exterior GFCI & Appliance Feeds",
    img: "/assets/images/real/outdoor_outlets/img_5884.webp",
    alt: "Exterior weatherproof bell box with raised clear polycarbonate in-use bubble cover and white GFCI receptacle",
    fx: "56% 48%",
    desc: "Extra-duty polycarbonate in-use GFCI receptacles, underground Schedule 40 PVC risers, and tankless heater circuits.",
    link: "#quote"
  },
  {
    title: "Crawlspace, Slab Trench & Open-Stud Rewiring",
    img: "/assets/images/real/wire_raceways_neat_and_oragnized_open_walls_no_sheetrock/img_0174.webp",
    alt: "Open-wall residential electrical rough-in showing a blue two-gang switch box with stapled NM-B Romex cables",
    fx: "52% 54%",
    desc: "NEC 334.30 stapled crawlspace raceways, saw-cut kitchen island slab conduit, and historic home copper rewiring.",
    link: "#quote"
  },
  {
    title: "24/7 Emergency Electrical Troubleshooting",
    img: "/assets/images/real/panels/img_3369.webp",
    alt: "Open legacy split-bus electrical panel during pre-remediation safety inspection",
    fx: "46% 52%",
    desc: "Rapid Master Electrician dispatch for tripping main breakers, burning odors, arcing splices, and storm outage damage.",
    link: "/contact"
  }
];

const serviceShowcasePhotos = [
  { src: '/assets/images/real/panels/img_3626.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_4525.webp', alt: '', title: '' },
  { src: '/assets/images/real/panels/img_4251.webp', alt: '', title: '' },
  { src: '/assets/images/real/chandeliers/img_1645.webp', alt: '', title: '' },
  { src: '/assets/images/real/outdoor_lights/img_3559.webp', alt: '', title: '' },
  { src: '/assets/images/real/twisted_insulated_copper_ready_for_wire_nut/img_4992.webp', alt: '', title: '' }
];
---

<Layout
  title="200A Panel Upgrades, EV Chargers, Generators & Commercial Electrical Services in 757 | Scott's Electric"
  description="Complete residential, commercial & 24/7 emergency electrical services across Virginia Beach, Norfolk, Chesapeake & all 7 cities of 757. Call (757) 536-0478."
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
        Residential • 3-Phase Commercial • 24/7 Emergency Dispatch
      </span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white mt-4 leading-tight max-w-5xl mx-auto">
        200A Panels, EV Chargers, Standby Generators &amp; <span class="gold-gradient-text">Electrical Services in 757</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-3xl mx-auto">
        Every scope below is illustrated with real jobsite photography from our licensed Virginia Master Electricians serving all 7 cities of Hampton Roads.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
          Call 24/7 Dispatch: (757) 536-0478
        </a>
        <a href="#quote" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-6 py-3.5 rounded-2xl text-sm">
          Calculate Project Estimate ↓
        </a>
      </div>

      <div class="mt-10 max-w-5xl mx-auto text-left">
        <AEODirectAnswer
          question="What residential and commercial electrical services are available across Hampton Roads (757)?"
          summary="Scott's Electric LLC executes 200A/400A main breaker panel upgrades, dedicated 240V Level 2 EV charger circuits, automatic standby generators, NEC Article 680 pool automation subpanels, two-story foyer chandelier rigging, and 120/208V & 277/480V 3-phase commercial switchgear across Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk."
          facts={[
            { label: "Emergency Dispatch", value: "24/7 Call: (757) 536-0478", highlight: true },
            { label: "Panel Replacements", value: "200A & 400A Solid Copper Bus" },
            { label: "EV & Pool Circuits", value: "240V Dedicated + NEC 680 Pads", highlight: true },
            { label: "3-Phase Commercial", value: "Square D I-Line, NQ & Meter Banks" },
            { label: "Municipal Permits", value: "Filed Across All 7 Cities" },
            { label: "Credential", value: "VA Class A Master Contractor" }
          ]}
          cityName="Hampton Roads (757)"
        />
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {allServices.map(srv => (
          <article class="group bento-card rounded-3xl overflow-hidden flex flex-col justify-between">
            <div>
              <div class="relative h-52 overflow-hidden bg-slate-950 vf-corners">
                <img
                  src={srv.img}
                  alt={srv.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${srv.fx};`}
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
              </div>
              <div class="p-6">
                <h2 class="font-heading text-xl font-bold text-white group-hover:text-amber-300 transition-colors mb-2">{srv.title}</h2>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{srv.desc}</p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-0 space-y-2">
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
                <a href="tel:7575360478" class="font-mono font-extrabold text-amber-400 hover:text-amber-300">
                  Call (757) 536-0478
                </a>
                <a href={srv.link} class="font-bold text-cyan-400 hover:text-white">
                  Scope Details →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <JobsiteGallery
    title="Additional Verified Field Installations Across 757"
    subtitle="Authentic close-up documentation of busbars, relays, fusible disconnects, and pre-twisted solid copper conductors."
    badge="Field Proof"
    photos={serviceShowcasePhotos}
    columns="3"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>
</Layout>
