---
import Layout from '../layouts/Layout.astro';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "About", url: `${siteConfig.url}/about` }
];

const craftsmanshipPhotos = [
  {
    src: '/assets/images/real/work_van_and_tools/img_4539.webp',
    alt: "Service Van and Tools",
    title: "Service Vans & Tools",
    category: "Equipment",
    desc: "Equipped service vehicle with electrical tooling and diagnostic gear."
  },
  {
    src: '/assets/images/real/wire_raceways_neat_and_oragnized_open_walls_no_sheetrock/img_0174.webp',
    alt: "Neat and Organized Wire Raceways Open Walls",
    title: "Wire Raceways & Rough-In",
    category: "Rough-In",
    desc: "Organized open-wall cable runs and code-compliant stapling."
  },
  {
    src: '/assets/images/real/twisted_insulated_copper_ready_for_wire_nut/img_4992.webp',
    alt: "Twisted Insulated Solid Copper Wire Ready for Wire Nut",
    title: "Twisted Insulated Copper Wire",
    category: "Conductors",
    desc: "Twisted solid copper conductors prepared for secure wire nut connection."
  },
  {
    src: '/assets/images/real/pigtailed_and_wire_nut_wire_open_box_in_sheet_rock/img_8405.webp',
    alt: "Pigtailed Wire Nut Open Box in Sheetrock",
    title: "Pigtailed & Wire Nut Connections",
    category: "Junction Boxes",
    desc: "Conductor pigtailing and secure wire nut connections in open box."
  },
  {
    src: '/assets/images/real/under_house_raceway_stapled_wire_neat_and_organized/img_0348.webp',
    alt: "Under-House Crawlspace Raceway Wiring",
    title: "Under-House Crawlspace Wiring",
    category: "Cable Management",
    desc: "Neatly stapled and organized crawlspace cable runs."
  },
  {
    src: '/assets/images/real/scotts_electric_employee_in_action/img_2846.webp',
    alt: "Scott's Electric Technician at Work",
    title: "Electrician on the Job",
    category: "Field Work",
    desc: "Electrical troubleshooting, testing, and panel diagnostics."
  }
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${siteConfig.url}/about#webpage`,
      "url": `${siteConfig.url}/about`,
      "name": "About Scott's Electric | Master Electricians in Hampton Roads 757",
      "description": "Learn about Scott's Electric, Hampton Roads' trusted Master Electrician serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk.",
      "isPartOf": { "@id": `${siteConfig.url}/#website` },
      "about": { "@id": `${siteConfig.url}/#organization` }
    }
  ]
};
---

<Layout 
  title="About Scott's Electric | Master Electricians in Hampton Roads 757"
  description="Learn about Scott's Electric, Hampton Roads' trusted Master Electrician serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk. 24/7 emergency dispatch."
  breadcrumbs={breadcrumbs}
  customSchema={[aboutSchema]}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            Master Electricians Since Day One
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            About <span class="gold-gradient-text">Scott's Electric</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            Founded on the pillars of safety, precision, and uncompromised craftsmanship, Scott's Electric is Coastal Virginia's leading electrical contracting team. We serve homeowners, business owners, and property managers throughout the 7 cities of 757.
          </p>
          <p class="mt-4 text-sm text-gray-400 leading-relaxed">
            Whether installing a Level 2 EV charger in Virginia Beach, rewiring a historic Ghent home in Norfolk, or protecting a Suffolk farm estate with standby generator power, our certified Master Electricians handle every detail with code-compliant excellence.
          </p>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/scotts_electric_employee_in_action/img_2651.webp" alt="Scott's Electric Master Electrician working on electrical panel box in Hampton Roads" class="w-full h-auto object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Craftsmanship Gallery -->
  <JobsiteGallery 
    title="Master Craftsmanship & Real Jobsite Standards"
    subtitle="Take a look behind the walls at Scott's Electric's meticulous wiring, rough-in raceways, and vehicle tooling across Hampton Roads."
    badge="Uncompromising Quality"
    photos={craftsmanshipPhotos}
    columns="3"
  />

  <section class="py-20 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-3xl font-bold text-white mb-12">Our Core Commitments</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-panel p-8 rounded-3xl border border-gray-800">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="font-heading text-xl font-bold text-white mb-2">Uncompromising Safety</h3>
          <p class="text-xs text-gray-300">All work strictly adheres to the National Electrical Code (NEC) and municipal permits in all 7 cities.</p>
        </div>
        <div class="glass-panel p-8 rounded-3xl border border-gray-800">
          <div class="text-4xl mb-4">⏱️</div>
          <h3 class="font-heading text-xl font-bold text-white mb-2">24/7 Rapid Response</h3>
          <p class="text-xs text-gray-300">Electrical emergencies don't wait for business hours. Our dispatch team is ready 24 hours a day, 365 days a year.</p>
        </div>
        <div class="glass-panel p-8 rounded-3xl border border-gray-800">
          <div class="text-4xl mb-4">💡</div>
          <h3 class="font-heading text-xl font-bold text-white mb-2">Upfront Pricing</h3>
          <p class="text-xs text-gray-300">No surprise fees or hidden costs. We provide clear, transparent estimate calculations before work begins.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
