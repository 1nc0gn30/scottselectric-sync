---
import Layout from '../layouts/Layout.astro';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Licensed Master Electricians", url: `${siteConfig.url}/about` }
];

const craftsmanshipPhotos = [
  { src: '/assets/images/real/work_van_and_tools/img_4539.webp', alt: '', title: '' },
  { src: '/assets/images/real/wire_raceways_neat_and_oragnized_open_walls_no_sheetrock/img_0174.webp', alt: '', title: '' },
  { src: '/assets/images/real/twisted_insulated_copper_ready_for_wire_nut/img_4992.webp', alt: '', title: '' },
  { src: '/assets/images/real/pigtailed_and_wire_nut_wire_open_box_in_sheet_rock/img_8405.webp', alt: '', title: '' },
  { src: '/assets/images/real/chandeliers/img_3150.webp', alt: '', title: '' },
  { src: '/assets/images/real/scotts_electric_employee_in_action/img_2651.webp', alt: '', title: '' }
];

const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${siteConfig.url}/about/#aboutpage`,
  "url": `${siteConfig.url}/about/`,
  "name": "Licensed Virginia Master Electricians & VA Class A Electrical Contractor in 757 | Scott's Electric",
  "description": "Licensed & insured Virginia Master Electricians serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk since 2012.",
  "isPartOf": { "@id": `${siteConfig.url}/#website` },
  "about": { "@id": `${siteConfig.url}/#organization` }
};
---

<Layout
  title="Licensed Virginia Master Electricians & Class A Contractor in 757 | Scott's Electric"
  description="Licensed & insured Virginia Master Electricians serving Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth & Suffolk. Call 24/7: (757) 536-0478."
  breadcrumbs={breadcrumbs}
  customSchema={[aboutSchema]}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-block font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest">
            VA Class A Electrical Contractor • Est. 2012
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Licensed Virginia Master Electricians Serving <span class="gold-gradient-text">All 7 Cities of 757</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Every panel replacement, 240V EV feeder, 3-phase commercial distribution board, and crawlspace circuit run we complete is built to pass inspection the first time—and stay safe behind drywall for decades.
          </p>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Scott's Electric LLC operates outfitted field vehicles across Virginia Beach, Norfolk, Chesapeake, Newport News, Hampton, Portsmouth, and Suffolk with direct 24/7 Master Electrician phone dispatch.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a href="tel:7575360478" class="cta-phone-beam bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold px-7 py-3.5 rounded-2xl text-sm shadow-gold-intense">
              Call (757) 536-0478 — 24/7 Dispatch
            </a>
            <a href="/contact" class="border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-200 font-bold px-6 py-3.5 rounded-2xl text-sm">
              Online Quote Form →
            </a>
          </div>
        </div>

        <!-- Real Outfitted Fleet & Crawlspace Video Split -->
        <div class="lg:col-span-5 space-y-4">
          <div class="bento-card rounded-3xl overflow-hidden vf-corners">
            <img
              src="/assets/images/real/work_van_and_tools/img_4519.webp"
              alt="Open rear doors of an electrical contractor cargo van stocked with cordless power tools, fish tapes, wire spools, and roof ladders"
              class="w-full aspect-[4/3] object-cover object-[50%_44%]"
            />
          </div>
          <div class="bento-card rounded-2xl overflow-hidden grid grid-cols-12 items-center">
            <div class="col-span-5 h-28 bg-slate-950">
              <video
                src="/assets/videos/crawlspace_raceway.mp4"
                poster="/assets/images/real/under_house_raceway_stapled_wire_neat_and_organized/img_0348.webp"
                autoplay
                muted
                loop
                playsinline
                class="w-full h-full object-cover"
              ></video>
            </div>
            <div class="col-span-7 p-3.5">
              <div class="font-mono text-[10px] font-bold uppercase text-cyan-400">LIVE CRAWLSPACE REEL</div>
              <div class="text-xs font-bold text-white mt-0.5">Stapled 12-AWG NM-B Joist Runs</div>
              <div class="text-[11px] text-slate-400 mt-0.5">Clean vapor-lined crawlspace routing.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <JobsiteGallery
    title="Behind-the-Walls Wiring, Trenching & Splice Standards"
    subtitle="Real macro and rough-in photographs showing pre-twisted solid copper splices, open-stud boxes, sub-walkway conduit trenching, and staged THHN/Siemens gear."
    badge="Verified Craftsmanship"
    photos={craftsmanshipPhotos}
    columns="3"
  />
</Layout>
