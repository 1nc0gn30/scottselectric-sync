---
import Layout from '../layouts/Layout.astro';
import AEOFAQ from '../components/AEOFAQ.astro';
import InteractiveQuoteCalculator from '../components/InteractiveQuoteCalculator.jsx';
import JobsiteGallery from '../components/JobsiteGallery.astro';
import AEODirectAnswer from '../components/AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';

const breadcrumbs = [
  { name: "Home", url: siteConfig.url },
  { name: "Chesapeake Electrician", url: `${siteConfig.url}/chesapeake-electrician` }
];

const chesapeakePhotos = [
  {
    src: '/assets/images/real/ceiling_fans/img_4926.webp',
    alt: "Great Bridge Chesapeake Ceiling Fan and Lighting Installation",
    title: "Great Bridge Ceiling Fan & Fixtures",
    category: "Chesapeake",
    desc: "Precision fan-rated mounting, balance tuning, and dual wall control switches."
  },
  {
    src: '/assets/images/real/panels/img_3369.webp',
    alt: "Greenbrier Chesapeake Dual Subpanel Load Expansion",
    title: "Greenbrier Subpanel Expansion",
    category: "Chesapeake",
    desc: "Upgraded subpanel distribution for additions, heat pumps, and workshops."
  },
  {
    src: '/assets/images/real/outdoor_power/img_5869.webp',
    alt: "Hickory Chesapeake Heavy Outdoor Disconnect for Pool and Spa",
    title: "Pool & Spa Heavy Power Disconnect",
    category: "Chesapeake",
    desc: "Dedicated 50A GFCI protection and outdoor bonding for residential pools."
  },
  {
    src: '/assets/images/real/outdoor_outlets/img_5721.webp',
    alt: "Western Branch Chesapeake Weatherproof Exterior GFCI Outlet",
    title: "Suburban Weatherproof Outlets",
    category: "Chesapeake",
    desc: "Extra-duty in-use wet location enclosures for patio, landscape, and yard equipment."
  }
];

const cityFaqs = [
  {
    question: "Which Chesapeake neighborhoods does Scott's Electric serve?",
    answer: "We serve all of Chesapeake including Greenbrier, Great Bridge, Western Branch, Deep Creek, South Norfolk, Hickory, Grassfield, and Indian River."
  },
  {
    question: "Can you install electrical wiring for a hot tub or swimming pool in Chesapeake?",
    answer: "Yes, we install dedicated 50A/60A GFCI subpanels, underground conduit, equipotential bonding grids, and automated heating circuits for all residential pools and hot tubs."
  },
  {
    question: "Do you install Level 2 EV chargers in Chesapeake garages and driveways?",
    answer: "Yes, we install high-speed Level 2 charging stations for Tesla, Ford Lightning, Rivian, and all EV models with complete Chesapeake city permits."
  }
];
---

<Layout 
  title="Electrician in Chesapeake VA | 24/7 Electrical Repair, Panels & Pool Wiring"
  description="Licensed Master Electrician in Chesapeake, VA serving Greenbrier, Great Bridge & Western Branch. Subpanels, EV chargers, hot tub wiring & 200A panel upgrades. Call (757) 536-0478."
  cityName="Chesapeake"
  serviceName="Chesapeake Electrical Contractor"
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-card to-brand-dark border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-xs font-bold text-brand-gold bg-brand-gold/10 px-3 py-1 rounded-full border border-brand-gold/20 uppercase tracking-widest">
            🏡 Chesapeake, VA Electrical Services
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-white mt-4 leading-tight">
            Reliable Electrician in <br />
            <span class="gold-gradient-text">Chesapeake, Virginia</span>
          </h1>
          <p class="mt-4 text-base text-gray-300 leading-relaxed">
            From Greenbrier commercial hubs to suburban homes in Great Bridge, Western Branch, Hickory, and Deep Creek—Scott's Electric offers fast, certified electrical repair and upgrades.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#quote" class="bg-brand-gold hover:bg-brand-goldHover text-black font-extrabold px-6 py-3 rounded-xl text-xs shadow-gold-glow">
              Get Chesapeake Estimate →
            </a>
            <a href="tel:7575360478" class="border border-brand-cyan/40 text-brand-cyan hover:bg-brand-cyan hover:text-black font-extrabold px-6 py-3 rounded-xl text-xs">
              📞 24/7 Chesapeake Dispatch: (757) 536-0478
            </a>
          </div>
        </div>
        <div class="relative rounded-3xl overflow-hidden shadow-card border border-gray-800">
          <img src="/assets/images/real/ceiling_fans/img_4926.webp" alt="Master Electrician in Chesapeake, VA" class="w-full h-auto object-cover" />
        </div>
      </div>

      <!-- Local AEO Direct Answer Block -->
      <AEODirectAnswer 
        question="Looking for top residential or commercial electricians in Chesapeake, VA?"
        summary="Scott's Electric provides 24/7 certified electrical repairs, 200A breaker upgrades, dedicated pool & spa circuits, subpanels, and Level 2 EV charging station installations across Greenbrier, Great Bridge, Western Branch, and Deep Creek."
        facts={[
          { label: "Chesapeake Response", value: "30-45 Minutes", highlight: true },
          { label: "Pool / Hot Tub Wiring", value: "NEC Article 680 Compliant" },
          { label: "City Permits", value: "Chesapeake Dept. of Development", highlight: true },
          { label: "Contractor License", value: "VA Class A #2710078492" },
          { label: "24/7 Phone Line", value: "(757) 536-0478" },
          { label: "Chesapeake ZIP Codes", value: "23320, 23321, 23322, 23323, 23324, 23325" }
        ]}
        cityName="Chesapeake"
      />
    </div>
  </section>

  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-8">
        Chesapeake Residential & Commercial Care
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🏊</div>
          <h3 class="font-heading text-xl font-bold text-white">Pool & Spa Wiring</h3>
          <p class="text-xs text-gray-300">
            Dedicated GFCI breakers, bonding, underwater lighting, and heater circuits for Chesapeake outdoor living spaces.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">🔌</div>
          <h3 class="font-heading text-xl font-bold text-white">Main Breaker Upgrades</h3>
          <p class="text-xs text-gray-300">
            Replace dangerous Federal Pacific or Zinsco panels with modern Siemens or Square D 200A breaker boxes.
          </p>
        </div>
        <div class="glass-panel p-6 rounded-2xl border border-gray-800 space-y-3">
          <div class="text-3xl">💡</div>
          <h3 class="font-heading text-xl font-bold text-white">Smart Lighting Setup</h3>
          <p class="text-xs text-gray-300">
            Voice-controlled lighting, automated dimmers, and energy-saving LED transformations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Work in Chesapeake Gallery -->
  <JobsiteGallery 
    title="Real Electrical Installations in Chesapeake"
    subtitle="Direct photos from ceiling fan installations, subpanel additions, pool/spa power disconnects, and outdoor GFCI boxes in Chesapeake."
    badge="Chesapeake Projects"
    photos={chesapeakePhotos}
    columns="4"
  />

  <section id="quote" class="py-16 bg-brand-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={cityFaqs} title="Chesapeake Electrical FAQ & Direct Answers" cityName="Chesapeake" />
</Layout>
