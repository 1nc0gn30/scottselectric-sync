---
import { siteConfig, getBusinessSchema, getWebSiteSchema, getWebPageSchema, getBreadcrumbSchema, getHowToQuoteSchema } from '../config/site.js';
import { getImageGallerySchema } from '../config/verifiedMedia.js';

interface Props {
  cityName?: string;
  serviceName?: string;
  pageTitle?: string;
  pageDescription?: string;
  canonicalUrl?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  customSchema?: any[];
  isServicePage?: boolean;
  serviceData?: {
    name: string;
    description: string;
    url: string;
    priceRange?: string;
  };
}

const {
  cityName = "Hampton Roads",
  serviceName = "24/7 Master Electrician & Panel Upgrades",
  pageTitle = `${serviceName} in ${cityName}, VA (757) | Scott's Electric`,
  pageDescription = `Licensed Virginia Master Electrician serving ${cityName} and all 7 cities of Hampton Roads (757). 24/7 Emergency Electrical Repair, 200A Panel Upgrades, EV Chargers & Standby Generators. Call (757) 536-0478.`,
  canonicalUrl,
  ogImage = siteConfig.heroImage,
  breadcrumbs = [{ name: "Home", url: `${siteConfig.url}/` }],
  customSchema = [],
  isServicePage = false,
  serviceData
} = Astro.props;

const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = canonicalUrl || `${siteConfig.url}${rawPath === '//' ? '/' : rawPath}`;

const businessSchema = getBusinessSchema(cityName);
const websiteSchema = getWebSiteSchema();
const webpageSchema = getWebPageSchema(pageUrl, pageTitle, pageDescription, ogImage);
const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const howToSchema = getHowToQuoteSchema();
const imageGallerySchema = getImageGallerySchema(siteConfig.url);

const webAppSchema = {
  "@type": "WebApplication",
  "@id": `${siteConfig.url}/#nec-estimator-app`,
  "name": "757 Electrical Project & NEC Article 220 Panel Load Calculator",
  "url": `${siteConfig.url}/#instant-calculator`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "description": "Free interactive NEC Article 220.82 residential dwelling load calculator and 757 electrical project budget estimator for 200A panel upgrades, Level 2 EV chargers, and standby generators.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "creator": { "@id": `${siteConfig.url}/#organization` },
  "provider": { "@id": `${siteConfig.url}/#organization` }
};

const graphItems: any[] = [
  businessSchema,
  websiteSchema,
  webpageSchema,
  webAppSchema,
  breadcrumbSchema,
  howToSchema,
  imageGallerySchema
];

function buildPriceSpec(rangeStr?: string) {
  if (!rangeStr) {
    return {
      "@type": "PriceSpecification",
      "priceCurrency": "USD",
      "description": "Upfront Master Electrician Quote"
    };
  }
  const nums = (rangeStr.match(/[\d,]+/g) || [])
    .map((n) => Number(n.replace(/,/g, '')))
    .filter((n) => Number.isFinite(n) && n >= 100);
  if (nums.length >= 2) {
    return {
      "@type": "PriceSpecification",
      "priceCurrency": "USD",
      "minPrice": nums[0],
      "maxPrice": nums[1],
      "description": rangeStr
    };
  }
  if (nums.length === 1) {
    return {
      "@type": "PriceSpecification",
      "priceCurrency": "USD",
      "minPrice": nums[0],
      "description": rangeStr
    };
  }
  return {
    "@type": "PriceSpecification",
    "priceCurrency": "USD",
    "description": rangeStr
  };
}

if (isServicePage && serviceData) {
  const svcUrl = serviceData.url.endsWith('/') ? serviceData.url : `${serviceData.url}/`;
  graphItems.push({
    "@type": "Service",
    "@id": `${svcUrl}#service`,
    "url": svcUrl,
    "name": serviceData.name,
    "description": serviceData.description,
    "provider": { "@id": `${siteConfig.url}/#organization` },
    "areaServed": businessSchema.areaServed,
    "serviceType": serviceData.name,
    "offers": {
      "@type": "Offer",
      "url": svcUrl,
      "priceCurrency": "USD",
      "priceSpecification": buildPriceSpec(serviceData.priceRange),
      "availability": "https://schema.org/InStock",
      "validFrom": "2026-01-01"
    }
  });
}

if (customSchema && customSchema.length > 0) {
  graphItems.push(...customSchema);
}

const fullSchemaGraph = {
  "@context": "https://schema.org",
  "@graph": graphItems
};
---

<!-- Connected JSON-LD Knowledge Graph for Search & AI Engines -->
<script type="application/ld+json" set:html={JSON.stringify(fullSchemaGraph)} />
