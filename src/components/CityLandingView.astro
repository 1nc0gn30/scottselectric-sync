---
import Layout from '../layouts/Layout.astro';
import AEOFAQ from './AEOFAQ.astro';
import InteractiveQuoteCalculator from './InteractiveQuoteCalculator.jsx';
import JobsiteGallery from './JobsiteGallery.astro';
import AEODirectAnswer from './AEODirectAnswer.astro';
import { siteConfig } from '../config/site.js';
import { getPhotoBySrc } from '../config/verifiedMedia.js';

interface Props {
  cityName: string;
  slug: string;
  pageTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1Lead: string;
  heroIntro: string;
  heroPhotoSrc: string;
  aeoQuestion: string;
  aeoSummary: string;
  aeoFacts: Array<{ label: string; value: string; highlight?: boolean }>;
  localScopes: Array<{ code: string; title: string; desc: string }>;
  galleryPhotos: Array<{ src: string; alt: string; title: string }>;
  faqs: Array<{ question: string; answer: string }>;
}

const {
  cityName,
  slug,
  pageTitle,
  metaDescription,
  eyebrow,
  h1Lead,
  heroIntro,
  heroPhotoSrc,
  aeoQuestion,
  aeoSummary,
  aeoFacts,
  localScopes,
  galleryPhotos,
  faqs,
} = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: siteConfig.url },
  { name: `${cityName} Electrician`, url: `${siteConfig.url}${slug}` },
];

const verifiedHero = getPhotoBySrc(heroPhotoSrc);
const heroAlt = verifiedHero ? verifiedHero.seoAlt : `Licensed Master Electrician in ${cityName}, VA`;
const heroSpec = verifiedHero ? verifiedHero.technicalSpec : `${cityName.toUpperCase()} FIELD WORK`;
const heroFx = verifiedHero?.focalPoint?.x ?? 50;
const heroFy = verifiedHero?.focalPoint?.y ?? 50;
---

<Layout
  title={pageTitle}
  description={metaDescription}
  cityName={cityName}
  serviceName={`24/7 Master Electrician in ${cityName}`}
  breadcrumbs={breadcrumbs}
>
  <section class="py-16 bg-gradient-to-b from-brand-surface to-brand-dark border-b border-slate-800/80 tech-grid-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-[11px] font-bold text-amber-400 bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/25 uppercase tracking-widest inline-block">
            {eyebrow}
          </span>
          <h1 class="font-heading text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            {h1Lead} <span class="gold-gradient-text">in {cityName}, VA</span>
          </h1>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            {heroIntro}
          </p>

          <!-- Phone-First CTA Pair -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <a
              href="tel:7575360478"
              class="cta-phone-beam inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 hover:from-amber-400 hover:to-yellow-300 text-slate-950 font-extrabold px-6 py-4 rounded-2xl text-sm sm:text-base shadow-gold-intense whitespace-nowrap"
            >
              <span>Call 24/7: (757) 536-0478</span>
            </a>
            <a
              href="#quote"
              class="inline-flex items-center justify-center border border-slate-700 hover:border-amber-400/60 bg-slate-900 text-slate-100 font-bold px-5 py-4 rounded-2xl text-sm whitespace-nowrap"
            >
              <span>NEC Load &amp; Price Estimator&nbsp;↓</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 bento-card rounded-3xl overflow-hidden vf-corners relative">
          <div class="relative aspect-[4/4.2] overflow-hidden bg-slate-950">
            <img
              src={heroPhotoSrc}
              alt={heroAlt}
              style={`object-position: ${heroFx}% ${heroFy}%;`}
              class="w-full h-full object-cover hf-cam-push-in"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
            <span class="absolute bottom-3.5 left-3.5 right-3.5 font-mono text-[10px] font-bold uppercase tracking-wider bg-slate-950/85 text-amber-400 px-2.5 py-1 rounded-md border border-amber-500/30 backdrop-blur-md truncate">
              {heroSpec}
            </span>
          </div>
        </div>
      </div>

      <AEODirectAnswer
        question={aeoQuestion}
        summary={aeoSummary}
        facts={aeoFacts}
        cityName={cityName}
      />
    </div>
  </section>

  <!-- Local Technical Scopes -->
  <section class="py-16 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white mb-8">
        High-Demand Electrical Services in {cityName}, VA
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {localScopes.map((scope) => (
          <div class="bento-card p-6 rounded-3xl flex flex-col justify-between space-y-4">
            <div class="space-y-2.5">
              <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-cyan-400">
                {scope.code}
              </span>
              <h3 class="font-heading text-xl font-bold text-white">{scope.title}</h3>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{scope.desc}</p>
            </div>
            <a href="tel:7575360478" class="pt-3 border-t border-slate-800 font-mono text-xs font-bold text-amber-400 hover:text-amber-300">
              Schedule in {cityName}: (757) 536-0478 →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <JobsiteGallery
    title={`Verified Jobsite Installations Serving ${cityName} & 757`}
    subtitle="Authentic field photographs of 200A panels, commercial switchgear, outdoor disconnects, and fixture mounts."
    badge="100% Real Field Photography"
    photos={galleryPhotos}
    columns="4"
  />

  <section id="quote" class="py-16 bg-brand-dark border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <InteractiveQuoteCalculator client:visible />
    </div>
  </section>

  <AEOFAQ faqs={faqs} title={`${cityName}, VA Electrical Permit, Cost & Dispatch FAQs`} cityName={cityName} />
</Layout>
