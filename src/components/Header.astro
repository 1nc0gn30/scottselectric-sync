---
const cities = [
  { name: 'Virginia Beach', slug: '/virginia-beach-electrician' },
  { name: 'Norfolk', slug: '/norfolk-electrician' },
  { name: 'Chesapeake', slug: '/chesapeake-electrician' },
  { name: 'Newport News', slug: '/newport-news-electrician' },
  { name: 'Hampton', slug: '/hampton-electrician' },
  { name: 'Portsmouth', slug: '/portsmouth-electrician' },
  { name: 'Suffolk', slug: '/suffolk-electrician' }
];

const services = [
  { name: '200A & 400A Panel Upgrades', slug: '/services/electrical-panel-upgrades' },
  { name: 'Level 2 EV Charger Circuits', slug: '/services/ev-charger-installation' },
  { name: 'Whole-Home Standby Generators', slug: '/services/whole-home-generators' },
  { name: 'Chandeliers & Recessed Lighting', slug: '/services/custom-lighting-installation' },
  { name: 'Smart Switches & Energy Monitors', slug: '/services/smart-home-automation' },
  { name: '3-Phase Commercial Electrical', slug: '/services/commercial-electrical' }
];
---

<header class="fixed top-0 left-0 right-0 z-40 glass-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-3">
      <!-- Compact Emblem + Keyword Descriptor -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="757 Master Electrician — Scott's Electric Home">
        <img
          src="/assets/images/scotts_electric_logo_transparent.png"
          alt="Licensed Master Electrician in Hampton Roads VA — Scott's Electric Emblem"
          width="64"
          height="64"
          class="h-12 sm:h-14 w-auto object-contain group-hover:scale-105 transition-transform"
        />
        <div class="hidden xl:block leading-tight">
          <span class="block font-mono text-[10px] font-bold uppercase tracking-widest text-amber-400">
            757 MASTER ELECTRICIAN
          </span>
          <span class="block font-heading text-sm font-extrabold text-white">
            Scott's Electric
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6 text-xs xl:text-sm font-semibold text-slate-100" aria-label="Main Navigation">
        <a href="/#field-motion-reel" class="hover:text-teal-300 transition-colors">Electrical Scopes</a>
        <a href="/#verified-photo-vault" class="hover:text-teal-300 transition-colors">Field Archive</a>

        <!-- Services Dropdown -->
        <div class="relative group py-4">
          <button type="button" class="flex items-center gap-1.5 hover:text-amber-400 transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span>Electrical Services</span>
            <svg class="w-3.5 h-3.5 text-amber-400 group-hover:rotate-180 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-64 glass-panel rounded-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl border border-slate-800">
            {services.map(service => (
              <a href={service.slug} class="block px-4 py-2.5 text-xs text-slate-300 hover:bg-slate-800/80 hover:text-amber-400 transition-colors">
                {service.name}
              </a>
            ))}
            <div class="border-t border-slate-800 my-1"></div>
            <a href="/services" class="block px-4 py-2 text-xs font-bold text-cyan-400 hover:text-white transition-colors">
              All Electrical Services →
            </a>
          </div>
        </div>

        <!-- 7 Cities Dropdown -->
        <div class="relative group py-4">
          <button type="button" class="flex items-center gap-1.5 hover:text-amber-400 transition-colors focus:outline-none" aria-expanded="false" aria-haspopup="true">
            <span class="text-amber-400">757 Cities</span>
            <svg class="w-3.5 h-3.5 text-amber-400 group-hover:rotate-180 transition-transform" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="absolute top-full left-0 w-56 glass-panel rounded-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl border border-slate-800">
            {cities.map(city => (
              <a href={city.slug} class="block px-4 py-2 text-xs text-slate-300 hover:bg-slate-800/80 hover:text-amber-400 transition-colors">
                {city.name}, VA Electrician
              </a>
            ))}
          </div>
        </div>

        <a href="/faqs" class="hover:text-amber-400 transition-colors">FAQs</a>
        <a href="/contact" class="hover:text-amber-400 transition-colors">Quote Form</a>
      </nav>

      <!-- Always-Visible Phone CTA + Mobile Menu Toggle -->
      <div class="flex items-center gap-2.5">
        <a
          href="tel:7575360478"
          class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition-colors shadow-gold-glow min-h-[44px]"
        >
          <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="font-mono tracking-tight">(757) 536-0478</span>
        </a>

        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 hover:text-amber-400 focus:outline-none min-h-[44px] min-w-[44px] flex items-center justify-center"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-950/98 border-b border-slate-800 px-4 pt-3 pb-6 space-y-4">
    <div class="grid grid-cols-2 gap-2">
      <a href="/#field-motion-reel" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-slate-200">Field Reel</a>
      <a href="/#verified-photo-vault" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-slate-200">Photo Archive</a>
      <a href="/services" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-slate-200">All Services</a>
      <a href="/contact" class="px-3 py-2.5 rounded-xl bg-slate-900 text-xs font-bold text-amber-400">Quote Form</a>
    </div>

    <div>
      <div class="px-1 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-amber-400">757 Service Cities</div>
      <div class="grid grid-cols-2 gap-1.5">
        {cities.map(city => (
          <a href={city.slug} class="text-xs text-slate-300 hover:text-amber-400 py-1.5 px-2 rounded-lg bg-slate-900/60">
            {city.name}, VA
          </a>
        ))}
      </div>
    </div>

    <div>
      <div class="px-1 pb-1.5 font-mono text-[10px] font-bold uppercase tracking-widest text-cyan-400">Primary Electrical Scopes</div>
      <div class="space-y-1">
        {services.map(service => (
          <a href={service.slug} class="block text-xs text-slate-300 hover:text-amber-400 py-2 px-2 rounded-lg hover:bg-slate-900">
            {service.name}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-2 border-t border-slate-800">
      <a href="tel:7575360478" class="block text-center bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 font-extrabold py-3.5 rounded-xl text-sm">
        Call 24/7 Dispatch: (757) 536-0478
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
