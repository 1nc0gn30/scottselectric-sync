---
interface Props {
  cityName: string;
  slug: string;
  description: string;
  corridor?: string;
  zipSample?: string;
  photoSrc?: string;
  photoAlt?: string;
  photoFx?: number;
  photoFy?: number;
}

const {
  cityName,
  slug,
  description,
  corridor = "24/7 Coastal Dispatch",
  zipSample = "757 Area",
  photoSrc,
  photoAlt,
  photoFx = 50,
  photoFy = 50,
} = Astro.props;
---

<a
  href={slug}
  data-deal-item
  class="group sand-card rounded-3xl overflow-hidden flex flex-col justify-between hover:-translate-y-1"
>
  <div>
    {photoSrc && (
      <div class="relative h-44 overflow-hidden bg-coastal-navy">
        <img
          data-parallax-img
          src={photoSrc}
          alt={photoAlt || `Licensed Master Electrician serving ${cityName}, Virginia`}
          loading="lazy"
          decoding="async"
          style={`object-position: ${photoFx}% ${photoFy}%;`}
          class="w-full h-full object-cover"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-coastal-navy/80 via-transparent to-transparent"></div>
        <span class="absolute top-3 left-3 font-mono text-[10px] font-bold uppercase tracking-wider bg-white/95 text-coastal-navy px-2.5 py-1 rounded-full shadow-sm">
          ZIP {zipSample}
        </span>
      </div>
    )}

    <div class="p-6">
      <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-teal-700 mb-1.5">
        {corridor}
      </div>
      <h3 class="font-heading text-xl font-extrabold text-coastal-navy group-hover:text-teal-700 transition-colors mb-2">
        Electrician in {cityName}, VA
      </h3>
      <p class="text-xs sm:text-sm text-coastal-slate leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  <div class="px-6 pb-5 pt-0">
    <div class="pt-3.5 border-t border-coastal-navy/10 flex items-center justify-between text-xs">
      <span class="font-mono text-[11px] text-coastal-navy font-bold">(757) 536-0478</span>
      <span class="text-teal-700 font-extrabold group-hover:translate-x-1 transition-transform">
        {cityName} Guide →
      </span>
    </div>
  </div>
</a>
