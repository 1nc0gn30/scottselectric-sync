---
const cities = [
  { name: 'Virginia Beach', slug: '/virginia-beach-electrician' },
  { name: 'Norfolk', slug: '/norfolk-electrician' },
  { name: 'Chesapeake', slug: '/chesapeake-electrician' },
  { name: 'Newport News', slug: '/newport-news-electrician' },
  { name: 'Hampton', slug: '/hampton-electrician' },
  { name: 'Portsmouth', slug: '/portsmouth-electrician' },
  { name: 'Suffolk', slug: '/suffolk-electrician' }
];

const services = [
  { name: '200A & 400A Electrical Panel Upgrades', href: '/services/electrical-panel-upgrades' },
  { name: 'Level 2 EV Charger Installation (240V)', href: '/services/ev-charger-installation' },
  { name: 'Whole-Home Standby Generators & ATS', href: '/services/whole-home-generators' },
  { name: 'Chandeliers, Recessed & Landscape Lighting', href: '/services/custom-lighting-installation' },
  { name: 'Smart Switches & Whole-Home Energy Monitors', href: '/services/smart-home-automation' },
  { name: '3-Phase Commercial Electrical & Meter Banks', href: '/services/commercial-electrical' },
  { name: 'NEC Article 680 Pool & Hot Tub Subpanels', href: '/services' },
  { name: '24/7 Emergency Electrical Troubleshooting', href: '/contact' },
];
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800/90 pt-16 pb-28 sm:pb-24 mt-16 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Col 1: Keyword Authority & Credentials -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/assets/images/scotts_electric_logo_transparent.png"
            alt="Licensed Master Electrician in Hampton Roads 757 — Scott's Electric"
            width="80"
            height="80"
            class="h-16 w-auto object-contain"
          />
          <div>
            <div class="font-mono text-[10px] font-bold uppercase tracking-widest text-amber-400">
              VA CLASS A CONTRACTOR
            </div>
            <div class="font-heading text-lg font-extrabold text-white">
              Scott's Electric LLC
            </div>
          </div>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Licensed &amp; insured Virginia Master Electrician providing 24/7 emergency repair, 200A/400A panel replacements, Level 2 EV charging circuits, 3-phase commercial switchgear, and standby generators across all 7 cities of 757.
        </p>
        <div class="font-mono text-[11px] text-slate-300">
          2829 Shore Dr, Virginia Beach, VA 23451
        </div>
      </div>

      <!-- Col 2: 7 Cities Local SEO Hub -->
      <div>
        <h3 class="font-heading font-bold text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          757 Service Cities
        </h3>
        <ul class="space-y-2 text-xs">
          {cities.map(city => (
            <li>
              <a href={city.slug} class="hover:text-amber-400 transition-colors flex items-center justify-between py-0.5">
                <span>Electrician in {city.name}, VA</span>
                <span class="font-mono text-[10px] text-slate-600">757 →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: High-Intent Electrical Scopes -->
      <div>
        <h3 class="font-heading font-bold text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Electrical Scopes
        </h3>
        <ul class="space-y-2 text-xs">
          {services.map(service => (
            <li>
              <a href={service.href} class="hover:text-amber-400 transition-colors block py-0.5">
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Phone-First Dispatch & Form -->
      <div class="space-y-4">
        <h3 class="font-heading font-bold text-white text-sm uppercase tracking-wider border-b border-slate-800 pb-2">
          24/7 Direct Dispatch
        </h3>
        <div class="bento-card p-5 rounded-2xl space-y-4">
          <div>
            <div class="font-mono text-[10px] text-amber-400 uppercase tracking-widest">
              Primary 24/7 Dispatch Line
            </div>
            <a href="tel:7575360478" class="font-mono text-xl font-extrabold text-white hover:text-amber-400 transition-colors block mt-1">
              (757) 536-0478
            </a>
          </div>
          <div>
            <div class="font-mono text-[10px] text-slate-400 uppercase tracking-widest">
              Written Estimates &amp; Scheduling
            </div>
            <a href="/contact" class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-400 hover:text-white mt-1">
              <span>Open Online Contact &amp; Quote Form</span>
              <span>→</span>
            </a>
          </div>
          <div class="pt-2 border-t border-slate-800/80 text-[11px] text-slate-300">
            <span class="text-emerald-400 font-bold">● Live 24/7 Emergency Response</span> across Southside &amp; Peninsula
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="mt-12 pt-6 border-t border-slate-900 flex flex-col lg:flex-row items-start lg:items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        &copy; {new Date().getFullYear()} Scott's Electric LLC. All rights reserved. Licensed &amp; Insured Virginia Master Electrician serving all 7 cities of 757.
      </div>

      <div class="flex flex-wrap items-center gap-5 shrink-0">
        <a href="/about" class="hover:text-slate-300">About</a>
        <a href="/faqs" class="hover:text-slate-300">FAQs</a>
        <a href="/ax" class="hover:text-slate-300">AI / AX Entity</a>
        <a href="/privacy" class="hover:text-slate-300">Privacy</a>
        <a href="/terms" class="hover:text-slate-300">Terms</a>
        <a href="/sitemap.xml" class="hover:text-slate-300">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
